{% include "base_templates/base_template.sv.j2" %}

// Attribute Tests: {{ environment.env_name }}_attr_test
//
// **一条 tests: 条目 = 一个 UVM_TEST = 一个属性取值**（维度 × 取值）。
// 属性经 uvm_config_db 传递，键 <key>_int 是机器可读的整型通道 ——
// **取值的中文只出现在注释里，不进 SV 字面量**（字面量会被比较、被打印，
// 掺进非 ASCII 是 locale 隐患；注释没有这个问题）。
//
// 消费方（env / sequence / driver）读 <key>_int 之后按自己的语义解释 ——
// 本模板不知道也不该知道「0/10/50/100 分别代表什么」。

// 生成一条属性 test。两条注意：
//   1. 宏体内**只能用 /* */ 注释** —— `//` 会把行尾的反斜杠一起吃掉，
//      宏定义当场断在那一行（SV 宏的经典坑，别改回去）。
//   2. 宏**不收中文取值**：可读的取值由上面那行 `// ── 属性 test N：… ──`
//      注释承载。把中文当宏参数传，源码里就会出现非 ASCII 的字符串字面量 ——
//      那正是这套设计要避开的。
`define GEN_ATTR_TC(tc_name, tc_base, tc_key, tc_int, tc_field) \
class tc_name extends tc_base; \
    `uvm_component_utils(tc_name) \
    function new(string name, uvm_component parent); \
        super.new(name, parent); \
    endfunction \
    virtual function void build_phase(uvm_phase phase); \
        super.build_phase(phase); \
        /* 本 test 的属性取值见上方注释；机器通道是下面这个 int */ \
        uvm_config_db#(int)::set(this, "*", {tc_key, "_int"}, tc_int); \
        /* 激励通道：绑定了事务字段的维度，把它一并钉在字段名下。 */ \
        /* sequence 读 "<字段>_int" 并约束事务；空的（观测型维度）不设。 */ \
        if (tc_field != "") \
            uvm_config_db#(int)::set(this, "*", {tc_field, "_int"}, tc_int); \
    endfunction \
endclass

{% for t in tests %}
// ── 属性 test {{ loop.index }}：{{ t.dimension }} = {{ t.value }} ──
{%- if t.tp_id %}
// 测试点：{{ t.tp_id }}（覆盖仓 / 回归级 / 签核判据都按这个编号对齐）
{%- endif %}
// 维度通道（env / 其它消费方按需打开）：
//   int attr_{{ t | attr_key }};  /* 取值：{{ t.value }} */
//   if (!uvm_config_db#(int)::get(this, "", "{{ t | attr_key }}_int", attr_{{ t | attr_key }}))
//     `uvm_fatal("ATTR", "{{ t | attr_key }}_int 没设上")
{%- if t.field %}
// **激励绑定**：该取值由事务字段 `{{ t.field }}` 承载 —— 本 test 会
//   set("{{ t.field }}_int", {{ t | attr_int_value }})，master sequence 读它
//   并约束 `{{ t.field }}`，所以这个 test 的激励**确实与其它取值不同**。
{%- else %}
// **观测型维度**：模型没有声明 `stimulus.field` —— 该取值不是事务字段，
//   没法通过激励钉住（通常是 DUT 内部量 / 输出端口 / 派生量）。
//   本 test 只跑激励并把 config_db 通道打开，**不建立取值差异**；
//   要让它真正生效，得在模型里写：
//     stimulus:
//       field: <seq_item 上的 rand 字段名>
{%- endif %}
// 类名 {{ environment.env_name }}_{{ t | attr_class_slug }}_test
{%- if t.backdoor_path %}
// **后门到达**：该维度没有输入引脚（内部状态/输出），用 `uvm_hdl_force`
// 把层次路径摆到目标值，采完覆盖再 release。签核里会单列为
// `BACKDOOR_HIT`，**不冒充激励覆盖**。
class {{ environment.env_name }}_{{ t | attr_class_slug }}_test extends {{ t.base or (environment.env_name ~ "_gen_test") }};
  `uvm_component_utils({{ environment.env_name }}_{{ t | attr_class_slug }}_test)
  function new(string name = "{{ environment.env_name }}_{{ t | attr_class_slug }}_test",
               uvm_component parent = null);
    super.new(name, parent);
  endfunction

  virtual task main_phase(uvm_phase phase);
    phase.raise_objection(this);
    // 复位在 100ns 释放；先让 DUT 稳定几个沿，再强制内部状态
    #(200ns);
    if (!uvm_hdl_force("{{ t.backdoor_path }}", {{ t | attr_int_value }}))
      `uvm_error("BACKDOOR", "force 失败：{{ t.backdoor_path }}")
    // 覆盖探针在时钟沿采样；保持足够长时间确保命中
    #(200ns);
    if (!uvm_hdl_release("{{ t.backdoor_path }}"))
      `uvm_warning("BACKDOOR", "release 失败：{{ t.backdoor_path }}")
    #(50ns);
    phase.drop_objection(this);
  endtask
endclass
{%- elif t.sequence_values and t.field %}
// **sequence 场景**：{{ t.sequence or "未命名场景" }}
// 逐笔取值写进 `{{ t.field }}_seq_*` 通道，master sequence 每笔事务按序取值。
// 这是"相邻指令组合"这类测试点唯一能建立确定差异的方式 —— 单个字段取值
// 表达不了时序。缺 `sequence_values` 的 sequence 维度不会走到这里（见
// 上面的观测型分支），**不拿一个空场景冒充已实现**。
class {{ environment.env_name }}_{{ t | attr_class_slug }}_test extends {{ t.base or (environment.env_name ~ "_gen_test") }};
  `uvm_component_utils({{ environment.env_name }}_{{ t | attr_class_slug }}_test)
  function new(string name = "{{ environment.env_name }}_{{ t | attr_class_slug }}_test",
               uvm_component parent = null);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    uvm_config_db#(int)::set(this, "*", "{{ t | attr_key }}_int", {{ t | attr_int_value }});
    uvm_config_db#(int)::set(this, "*", "{{ t.field }}_seq_len", {{ t.sequence_values | length }});
{%- for v in t.sequence_values %}
    uvm_config_db#(int)::set(this, "*", "{{ t.field }}_seq_{{ loop.index0 }}", {{ v }});
{%- endfor %}
  endfunction
endclass
{%- else %}
`GEN_ATTR_TC({{ environment.env_name }}_{{ t | attr_class_slug }}_test, {{ t.base or (environment.env_name ~ "_gen_test") }}, "{{ t | attr_key }}", {{ t | attr_int_value }}, "{{ t.field }}")
{%- endif %}
{% endfor %}
