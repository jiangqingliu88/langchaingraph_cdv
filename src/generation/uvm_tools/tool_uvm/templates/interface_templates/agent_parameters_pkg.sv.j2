{% include "base_templates/base_template.sv.j2" %}

// ============================================================
// Agent Parameters Package: {{ agent.name }}_parameters_pkg
// ============================================================
// 集中管理接口/agent 参数（ADDR_WIDTH/DATA_WIDTH 等），
// 供 seq_item / config / driver / monitor 复用，避免各处硬编码。
// 注：类型别名走 <name>_typedefs_pkg（YAML typedefs），不在这里。
package {{ agent.name }}_parameters_pkg;
{%- for param in agent.parameters %}
  localparam {{ param.type }} {{ param.name }} = {{ param.value }};
{%- endfor %}
endpackage : {{ agent.name }}_parameters_pkg
