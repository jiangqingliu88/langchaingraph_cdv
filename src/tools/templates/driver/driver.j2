{% import 'base/component_macros.j2' as comp %}
{% import 'base/tlm_macros.j2' as tlm %}

{{ comp.component_header(driver_name, 'uvm_driver #(' + transaction_type + ')', description or 'UVM Driver Component') }}

class {{ driver_name }} extends uvm_driver #({{ transaction_type }});
    {{ comp.factory_registration(driver_name) }}
    
    // Virtual Interface
    virtual {{ interface_type }} vif;
    
    // Configuration
    {{ agent_config_type }} cfg;
    
    {% if has_analysis_port %}
    // Analysis Port
    {{ tlm.analysis_port_declaration('req_ap', transaction_type) }}
    {% endif %}
    
    // Constructor
    function new(string name, uvm_component parent);
        super.new(name, parent);
        {% if has_analysis_port %}
        req_ap = new("req_ap", this);
        {% endif %}
    endfunction
    
    // Build Phase
    function void build_phase(uvm_phase phase);
        super.build_phase(phase);
        
        {{ comp.config_db_get('virtual ' + interface_type, 'this', '', 'vif', 'NOVIF') }}
        {{ comp.config_db_get(agent_config_type, 'this', '', 'cfg', 'NOCFG') }}
    endfunction
    
    // Run Phase
    virtual task run_phase(uvm_phase phase);
        {% if reset_sequence %}
        // Wait for reset
        @(posedge vif.{{ reset_signal }});
        {% endif %}
        
        forever begin
            seq_item_port.get_next_item(req);
            
            {% if has_analysis_port %}
            req_ap.write(req);
            {% endif %}
            
            `uvm_info("{{ driver_name }}", 
                $sformatf("Driving transaction:\n%s", req.sprint()), UVM_HIGH)
            
            drive_transaction(req);
            
            seq_item_port.item_done();
        end
    endtask
    
    // Drive Transaction
    virtual task drive_transaction({{ transaction_type }} tr);
        {% for phase in drive_phases %}
        {{ phase.name }}_phase(tr);
        {% endfor %}
    endtask
    
    {% for phase in drive_phases %}
    // {{ phase.description or phase.name }} Phase
    virtual task {{ phase.name }}_phase({{ transaction_type }} tr);
        {{ phase.code | indent_code(8) }}
    endtask
    {% endfor %}
    
    {% if additional_methods %}
    {% for method in additional_methods %}
    // {{ method.description or '' }}
    virtual task {{ method.name }}({{ method.args or '' }});
        {{ method.code | indent_code(8) }}
    endtask
    {% endfor %}
    {% endif %}
    
endclass : {{ driver_name }}