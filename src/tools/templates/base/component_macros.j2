{# UVM组件通用宏 #}

{% macro component_header(name, parent_class='uvm_component', description='') %}
// ============================================
// {{ name }}
// {{ description }}
// Auto-generated by IC Verification Agent
// ============================================
{% endmacro %}

{% macro standard_phases() %}
// Build phase
function void build_phase(uvm_phase phase);
    super.build_phase(phase);
endfunction

// Connect phase
function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
endfunction

// End of elaboration phase
function void end_of_elaboration_phase(uvm_phase phase);
    super.end_of_elaboration_phase(phase);
endfunction

// Report phase
function void report_phase(uvm_phase phase);
    super.report_phase(phase);
endfunction
{% endmacro %}

{% macro factory_registration(class_name) %}
`uvm_component_utils({{ class_name }})
{% endmacro %}

{% macro config_db_get(type, context, name, var_name, fatal_msg='') %}
if(!uvm_config_db #({{ type }})::get({{ context }}, "{{ name }}", "{{ var_name }}", {{ var_name }}))
    `uvm_fatal("{{ fatal_msg or 'NOCFG' }}", "Failed to get {{ var_name }} from config DB")
{% endmacro %}

{% macro create_component(class_name, instance_name, parent='this') %}
{{ class_name }}::type_id::create("{{ instance_name }}", {{ parent }});
{% endmacro %}

{% macro create_object(class_name, instance_name) %}
{{ class_name }}::type_id::create("{{ instance_name }}");
{% endmacro %}