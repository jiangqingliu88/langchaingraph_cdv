{# TLM通信宏 #}

{% macro analysis_port_declaration(port_name, transaction_type) %}
uvm_analysis_port #({{ transaction_type }}) {{ port_name }};
{% endmacro %}

{% macro analysis_export_declaration(export_name, transaction_type) %}
uvm_analysis_export #({{ transaction_type }}) {{ export_name }};
{% endmacro %}

{% macro analysis_fifo_declaration(fifo_name, transaction_type) %}
uvm_tlm_analysis_fifo #({{ transaction_type }}) {{ fifo_name }};
{% endmacro %}

{% macro tlm_connection(from_component, from_port, to_component, to_port) %}
{{ from_component }}.{{ from_port }}.connect({{ to_component }}.{{ to_port }});
{% endmacro %}

{% macro blocking_put_port(name, transaction_type) %}
uvm_blocking_put_port #({{ transaction_type }}) {{ name }};
{% endmacro %}

{% macro blocking_get_port(name, transaction_type) %}
uvm_blocking_get_port #({{ transaction_type }}) {{ name }};
{% endmacro %}