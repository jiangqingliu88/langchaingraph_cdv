{% import 'base/component_macros.j2' as comp %}
{% import 'base/tlm_macros.j2' as tlm %}

{{ comp.component_header(coverage_collector_name, 'uvm_subscriber #(' + transaction_type + ')', 'Coverage Collector') }}

class {{ coverage_collector_name }} extends uvm_subscriber #({{ transaction_type }});
    `uvm_component_utils({{ coverage_collector_name }})
    
    // Transaction handle
    {{ transaction_type }} cov_transaction;
    
    // Covergroups
    {% for cg in covergroups %}
    covergroup {{ cg.name }};
        {% for cp in cg.coverpoints %}
        {{ cp.name }}: coverpoint cov_transaction.{{ cp.signal }}{% if cp.bins %} {
            {% for bin in cp.bins %}
            bins {{ bin.name }} = { {{ bin.values | join(', ') }} };
            {% endfor %}
        }{% endif %};
        {% endfor %}
        
        {% if cg.crosses %}
        {% for cross in cg.crosses %}
        {{ cross.name }}: cross {{ cross.coverpoints | join(', ') }};
        {% endfor %}
        {% endif %}
    endgroup
    {% endfor %}
    
    // Constructor
    function new(string name, uvm_component parent);
        super.new(name, parent);
        
        {% for cg in covergroups %}
        {{ cg.name }} = new();
        {% endfor %}
    endfunction
    
    // Write method (called when transaction received)
    function void write({{ transaction_type }} t);
        cov_transaction = t;
        
        {% for cg in covergroups %}
        {{ cg.name }}.sample();
        {% endfor %}
    endfunction
    
    // Report Phase
    function void report_phase(uvm_phase phase);
        super.report_phase(phase);
        
        `uvm_info("{{ coverage_collector_name }}", 
            "Coverage Report:", UVM_MEDIUM)
        
        {% for cg in covergroups %}
        `uvm_info("{{ coverage_collector_name }}", 
            $sformatf("  {{ cg.name }} Coverage: %.2f%%", 
            {{ cg.name }}.get_coverage()), UVM_MEDIUM)
        {% endfor %}
        
        `uvm_info("{{ coverage_collector_name }}", 
            $sformatf("  Overall Coverage: %.2f%%", 
            get_coverage()), UVM_MEDIUM)
    endfunction
    
    // Get coverage
    function real get_coverage();
        {% if covergroups|length == 1 %}
        return {{ covergroups[0].name }}.get_coverage();
        {% else %}
        real total = 0;
        {% for cg in covergroups %}
        total += {{ cg.name }}.get_coverage();
        {% endfor %}
        return total / {{ covergroups|length }};
        {% endif %}
    endfunction
    
endclass : {{ coverage_collector_name }}