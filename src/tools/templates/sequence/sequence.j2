{% import 'base/component_macros.j2' as comp %}

{{ comp.component_header(sequence_name, 'uvm_sequence #(' + item_type + ')', description or 'UVM Sequence') }}

class {{ sequence_name }} extends uvm_sequence #({{ item_type }});
    `uvm_object_utils({{ sequence_name }})
    
    // Random Variables
    {% for var in random_vars %}
    rand {{ var.type }} {{ var.name }}{% if var.default %} = {{ var.default }}{% endif %};
    {% endfor %}
    
    // Constraints
    {% for constraint in constraints %}
    constraint {{ constraint.name }} {
        {{ constraint.body | indent_code(8) }}
    }
    {% endfor %}
    
    // Constructor
    function new(string name="{{ sequence_name | lower }}");
        super.new(name);
    endfunction
    
    // Body
    virtual task body();
        {{ item_type }} item;
        {% if pre_body_code %}
        // Pre-body
        {{ pre_body_code | indent_code(8) }}
        {% endif %}
        
        {% if loop_variable %}
        repeat({{ loop_variable }}) begin
        {% else %}
        forever begin
        {% endif %}
            item = {{ item_type }}::type_id::create("item");
            
            // Start item
            start_item(item);
            
            // Randomize item
            {% if randomization_constraints %}
            if(!item.randomize() with {
                {% for constraint in randomization_constraints %}
                {{ constraint }};
                {% endfor %}
            }) begin
                `uvm_error("{{ sequence_name }}", "Randomization failed")
            end
            {% else %}
            if(!item.randomize()) begin
                `uvm_error("{{ sequence_name }}", "Randomization failed")
            end
            {% endif %}
            
            {% if post_randomize_code %}
            // Post-randomize
            {{ post_randomize_code | indent_code(12) }}
            {% endif %}
            
            // Finish item
            finish_item(item);
            
            {% if inter_item_delay %}
            // Inter-item delay
            {{ inter_item_delay | indent_code(12) }}
            {% endif %}
        end
        
        {% if post_body_code %}
        // Post-body
        {{ post_body_code | indent_code(8) }}
        {% endif %}
    endtask
    
    {% if additional_tasks %}
    {% for task in additional_tasks %}
    // {{ task.description or '' }}
    virtual task {{ task.name }}({{ task.args or '' }});
        {{ task.body | indent_code(8) }}
    endtask
    {% endfor %}
    {% endif %}
    
endclass : {{ sequence_name }}