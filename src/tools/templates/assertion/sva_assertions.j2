{# SVA断言模板 #}
{% import 'base/component_macros.j2' as comp %}

// ============================================
// SVA Assertions for {{ design_name }}
// Auto-generated by Assertion Engineer Agent
// ============================================

{% if package_name %}
package {{ package_name }};
    import uvm_pkg::*;
{% endif %}

{% for assertion in assertions %}
// {{ assertion.description or 'Assertion ' + loop.index|string }}
// Type: {{ assertion.type }}
// Severity: {{ assertion.severity or 'Error' }}
{% if assertion.type == 'immediate' %}
// Immediate Assertion
{% if assertion.label %}
{{ assertion.label }}: {% endif %}assert ({{ assertion.condition }})
    else ${{ assertion.severity.lower() or 'error' }}("{{ assertion.message or 'Assertion failed' }}");
{% elif assertion.type == 'concurrent' %}
// Concurrent Assertion
{% if assertion.sequence %}
sequence {{ assertion.sequence_name or 'seq_' + loop.index|string }};
    {{ assertion.sequence }}
endsequence
{% endif %}
property {{ assertion.property_name or 'prop_' + loop.index|string }};
    @({{ assertion.clock_edge or 'posedge ' + clock_signal }})
    {% if assertion.disable_condition %}
    disable iff ({{ assertion.disable_condition }})
    {% endif %}
    {{ assertion.property }};
endproperty
{% if assertion.label %}
{{ assertion.label }}: {% endif %}assert property({{ assertion.property_name or 'prop_' + loop.index|string }})
    else ${{ assertion.severity.lower() or 'error' }}("{{ assertion.message or 'Assertion failed at %t' }}", $time);
{% elif assertion.type == 'assume' %}
// Assume (for formal verification)
property {{ assertion.property_name or 'assume_' + loop.index|string }};
    @({{ assertion.clock_edge or 'posedge ' + clock_signal }})
    {{ assertion.property }};
endproperty
assume property({{ assertion.property_name or 'assume_' + loop.index|string }});
{% elif assertion.type == 'cover' %}
// Cover property
{% if assertion.label %}
{{ assertion.label }}: {% endif %}cover property(
    @({{ assertion.clock_edge or 'posedge ' + clock_signal }})
    {{ assertion.property }}
);
{% endif %}

{% endfor %}

{% if cover_properties %}
// ============================================
// Cover Properties
// ============================================
{% for cover in cover_properties %}
// {{ cover.description or 'Cover property ' + loop.index|string }}
cover property(
    @({{ cover.clock_edge or 'posedge ' + clock_signal }})
    {{ cover.property }}
);
{% endfor %}
{% endif %}

{% if assertion_bindings %}
// ============================================
// Assertion Bindings
// ============================================
{% for binding in assertion_bindings %}
bind {{ binding.module_path }} {{ binding.assertion_module }} {{ binding.instance_name }} (
    .{{ binding.ports | join(', .') }}
);
{% endfor %}
{% endif %}

{% if package_name %}
endpackage : {{ package_name }}
{% endif %}