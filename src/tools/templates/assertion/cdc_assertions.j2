{# CDC断言模板 #}

// ============================================
// CDC (Clock Domain Crossing) Assertions
// Design: {{ design_name }}
// ============================================

{% for cdc_path in cdc_paths %}
// ============================================
// CDC Path: {{ cdc_path.source_clock }} -> {{ cdc_path.dest_clock }}
// Signal: {{ cdc_path.signal_name }}
// Synchronizer: {{ cdc_path.synchronizer_type or '2-stage FF' }}
// ============================================

{% if cdc_path.synchronizer_type == '2-stage' or cdc_path.synchronizer_type == 'two_stage' %}
// Check synchronizer output stability
property sync_stable_{{ loop.index }};
    @(posedge {{ cdc_path.dest_clock }})
    {% if cdc_path.reset_signal %}
    disable iff(!{{ cdc_path.reset_signal }})
    {% endif %}
    $rose({{ cdc_path.sync_signal }}[1]) |-> {{ cdc_path.sync_signal }}[2];
endproperty
assert_sync_stable_{{ loop.index }}: assert property(sync_stable_{{ loop.index }})
    else $error("CDC synchronizer for {{ cdc_path.signal_name }} failed at %t", $time);

{% elif cdc_path.synchronizer_type == 'fifo' or cdc_path.synchronizer_type == 'async_fifo' %}
// Check FIFO pointers are gray-coded
property gray_code_{{ loop.index }};
    @(posedge {{ cdc_path.dest_clock }})
    $changed({{ cdc_path.pointer_signal }}) |-> 
        $onehot0({{ cdc_path.pointer_signal }} ^ $past({{ cdc_path.pointer_signal }}));
endproperty
assert_gray_code_{{ loop.index }}: assert property(gray_code_{{ loop.index }})
    else $error("FIFO pointer not gray-coded for {{ cdc_path.signal_name }}");

// Check FIFO not full/empty conditions
property fifo_not_both_{{ loop.index }};
    @(posedge {{ cdc_path.dest_clock }})
    !({{ cdc_path.full_flag }} && {{ cdc_path.empty_flag }});
endproperty
assert_fifo_not_both_{{ loop.index }}: assert property(fifo_not_both_{{ loop.index }})
    else $error("FIFO both full and empty for {{ cdc_path.signal_name }}");

{% elif cdc_path.synchronizer_type == 'handshake' %}
// Check handshake protocol
sequence handshake_seq_{{ loop.index }};
    @(posedge {{ cdc_path.source_clock }})
    {{ cdc_path.request_signal }} ##1 
    @(posedge {{ cdc_path.dest_clock }})
    {{ cdc_path.acknowledge_signal }}[->1] ##1
    @(posedge {{ cdc_path.source_clock }})
    !{{ cdc_path.request_signal }};
endsequence

property handshake_complete_{{ loop.index }};
    @(posedge {{ cdc_path.source_clock }})
    {{ cdc_path.request_signal }} |-> handshake_seq_{{ loop.index }};
endproperty
assert_handshake_{{ loop.index }}: assert property(handshake_complete_{{ loop.index }})
    else $error("Handshake protocol violation for {{ cdc_path.signal_name }}");

{% endif %}

// Check data stability during transfer
{% if cdc_path.data_stable_check %}
property data_stable_{{ loop.index }};
    @(posedge {{ cdc_path.source_clock }})
    {{ cdc_path.transfer_active }} |=> $stable({{ cdc_path.data_signal }});
endproperty
assert_data_stable_{{ loop.index }}: assert property(data_stable_{{ loop.index }})
    else $error("Data changed during CDC transfer for {{ cdc_path.signal_name }}");
{% endif %}

{% endfor %}

{% if cdc_coverage %}
// ============================================
// CDC Coverage
// ============================================
{% for cov in cdc_coverage %}
cover property(@(posedge {{ cov.clock }})
    {{ cov.property }}
);
{% endfor %}
{% endif %}