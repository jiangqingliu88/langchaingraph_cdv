{# 形式验证属性模板 #}

// ============================================
// Formal Verification Properties for {{ design_name }}
// ============================================

{% for property in formal_properties %}
// {{ property.description or 'Property ' + loop.index|string }}
// Type: {{ property.type }}  Status: {{ property.status or 'Unknown' }}
// {{ property.comment or '' }}

{% if property.type == 'safety' %}
// Safety Property
property {{ property.name or 'safety_prop_' + loop.index|string }};
    @({{ property.clock_edge or 'posedge ' + clock_signal }})
    {% if property.disable_condition %}
    disable iff ({{ property.disable_condition }})
    {% endif %}
    {{ property.property }};
endproperty
assert property({{ property.name or 'safety_prop_' + loop.index|string }})
    else $error("{{ property.error_message or 'Safety property violated' }}");
{% elif property.type == 'liveness' %}
// Liveness Property
property {{ property.name or 'live_prop_' + loop.index|string }};
    @({{ property.clock_edge or 'posedge ' + clock_signal }})
    {{ property.property }};
endproperty
{% if property.prove_cover %}
cover property({{ property.name or 'live_prop_' + loop.index|string }});
{% endif %}
{% elif property.type == 'invariant' %}
// Invariant Property
always @({{ property.clock_edge or 'posedge ' + clock_signal }})
    assert ({{ property.property }})
    else $error("{{ property.error_message or 'Invariant violated' }}");
{% endif %}

{% endfor %}

{% if assumptions %}
// ============================================
// Assumptions (for formal verification)
// ============================================
{% for assumption in assumptions %}
// {{ assumption.description or 'Assumption ' + loop.index|string }}
property {{ assumption.name or 'assume_prop_' + loop.index|string }};
    @({{ assumption.clock_edge or 'posedge ' + clock_signal }})
    {{ assumption.property }};
endproperty
assume property({{ assumption.name or 'assume_prop_' + loop.index|string }});
{% endfor %}
{% endif %}

{% if fairness_constraints %}
// ============================================
// Fairness Constraints
// ============================================
{% for fairness in fairness_constraints %}
// {{ fairness.description or 'Fairness constraint ' + loop.index|string }}
{{ fairness.statement }};
{% endfor %}
{% endif %}