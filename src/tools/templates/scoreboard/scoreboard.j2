{% import 'base/component_macros.j2' as comp %}
{% import 'base/tlm_macros.j2' as tlm %}

{{ comp.component_header(scoreboard_name, 'uvm_scoreboard', description or 'UVM Scoreboard Component') }}

class {{ scoreboard_name }} extends uvm_scoreboard;
    {{ comp.factory_registration(scoreboard_name) }}
    
    // Configuration
    {{ scoreboard_config_type }} cfg;
    
    // Analysis Exports
    {% for port in input_ports %}
    {{ tlm.analysis_export_declaration(port.name + '_export', port.transaction_type) }}
    {% endfor %}
    
    // Analysis FIFOs
    {% for port in input_ports %}
    {{ tlm.analysis_fifo_declaration(port.name + '_fifo', port.transaction_type) }}
    {% endfor %}
    
    // Predictor
    {{ predictor_name }} predictor;
    
    // Statistics
    protected int num_compared = 0;
    protected int num_mismatches = 0;
    protected int num_passed = 0;
    
    {% if has_logger %}
    // Logger
    protected {{ logger_name }} logger;
    {% endif %}
    
    // Constructor
    function new(string name, uvm_component parent);
        super.new(name, parent);
    endfunction
    
    // Build Phase
    function void build_phase(uvm_phase phase);
        super.build_phase(phase);
        
        {{ comp.config_db_get(scoreboard_config_type, 'this', '', 'cfg', 'NOCFG') }}
        
        {% for port in input_ports %}
        {{ port.name }}_export = new("{{ port.name }}_export", this);
        {{ port.name }}_fifo = new("{{ port.name }}_fifo", this);
        {% endfor %}
        
        predictor = {{ predictor_name }}::type_id::create("predictor", this);
        
        {% if has_logger %}
        logger = {{ comp.create_component(logger_name, 'logger') }}
        {% endif %}
    endfunction
    
    // Connect Phase
    function void connect_phase(uvm_phase phase);
        super.connect_phase(phase);
        
        {% for port in input_ports %}
        {{ port.name }}_export.connect({{ port.name }}_fifo.analysis_export);
        {% endfor %}
    endfunction
    
    // Run Phase
    virtual task run_phase(uvm_phase phase);
        fork
            {% for compare_task in compare_tasks %}
            {{ compare_task.name }}();
            {% endfor %}
        join
    endtask
    
    {% for compare_task in compare_tasks %}
    // {{ compare_task.description or 'Compare Task ' + loop.index|string }}
    virtual protected task {{ compare_task.name }}();
        {{ transaction_type }} {{ compare_task.input_var }}_tr;
        {{ transaction_type }} {{ compare_task.expected_var }}_tr;
        
        forever begin
            // Get actual transaction
            {{ compare_task.actual_fifo }}.get({{ compare_task.input_var }}_tr);
            
            // Predict expected transaction
            {{ compare_task.expected_var }}_tr = predictor.predict({{ compare_task.input_var }}_tr);
            
            // Compare
            if(!{{ compare_task.input_var }}_tr.compare({{ compare_task.expected_var }}_tr)) begin
                `uvm_error("{{ scoreboard_name }}", 
                    $sformatf("{{ compare_task.error_message or 'Mismatch detected' }}\nActual: %s\nExpected: %s", 
                    {{ compare_task.input_var }}_tr.sprint(), {{ compare_task.expected_var }}_tr.sprint()))
                num_mismatches++;
            end
            else begin
                `uvm_info("{{ scoreboard_name }}", "Transaction matched successfully", UVM_HIGH)
                num_passed++;
            end
            
            num_compared++;
        end
    endtask
    {% endfor %}
    
    // Report Phase
    function void report_phase(uvm_phase phase);
        super.report_phase(phase);
        
        `uvm_info("{{ scoreboard_name }}", 
            $sformatf("Scoreboard Report:\n  Total Compared: %0d\n  Passed: %0d\n  Mismatches: %0d\n  Pass Rate: %.2f%%", 
            num_compared, num_passed, num_mismatches, 
            (num_compared > 0) ? (num_passed * 100.0 / num_compared) : 0.0), 
            UVM_MEDIUM)
        
        if(num_mismatches > 0) begin
            `uvm_warning("{{ scoreboard_name }}", 
                $sformatf("Scoreboard detected %0d mismatches!", num_mismatches))
        end
    endfunction
    
endclass : {{ scoreboard_name }}