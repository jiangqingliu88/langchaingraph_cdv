{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signoffai.local/tool_uvm/uvm_config.schema.json",
  "title": "tool_uvm YAML config",
  "description": "tool_uvm 的 YAML 配置契约（一个文件 = 一个文档）。键名/类型/必填/枚举校验；严重度由 schema_check.py 按 validator 映射（unknown key → warning，其余 → error）。",
  "type": "object",
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "interfaces": { "$ref": "#/$defs/interfaceArray" },
    "interface": { "$ref": "#/$defs/interfaceArray" },
    "environment": { "$ref": "#/$defs/environment" },
    "bench": { "$ref": "#/$defs/bench" },
    "constraint": { "$ref": "#/$defs/constraintDoc" },
    "transactions": { "$ref": "#/$defs/transactions" },
    "policies": { "$ref": "#/$defs/policies" },
    "combinator": { "$ref": "#/$defs/combinator" },
    "harness": { "$ref": "#/$defs/harnessArray" },
    "util_components": {
      "oneOf": [
        { "$ref": "#/$defs/utilComponent" },
        { "type": "array", "items": { "$ref": "#/$defs/utilComponent" } }
      ]
    }
  },
  "anyOf": [
    { "required": ["interfaces"] },
    { "required": ["interface"] },
    { "required": ["environment"] },
    { "required": ["bench"] },
    { "required": ["constraint"] },
    { "required": ["harness"] },
    { "required": ["util_components"] }
  ],
  "additionalProperties": false,
  "$defs": {
    "meta": {
      "$comment": "文件头元数据：键名自由，值仅限标量（gen_uvm.py:2125 对值做 str()）",
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "boolLike": {
      "$comment": "YAML 布尔或 \"True\"/\"False\"/\"yes\"/\"no\"/\"1\"/\"0\" 字符串（_opt_bool, gen_uvm.py:697）",
      "type": ["boolean", "string"]
    },
    "isActive": {
      "$comment": "标量或 {master, slave} dict（_normalize_is_active, gen_uvm.py:485）；dict 缺省项 = UVM_ACTIVE，故 master/slave 不强制",
      "oneOf": [
        { "$ref": "#/$defs/boolLike" },
        {
          "type": "object",
          "properties": {
            "master": { "$ref": "#/$defs/boolLike" },
            "slave": { "$ref": "#/$defs/boolLike" }
          },
          "additionalProperties": false
        }
      ]
    },
    "interface": {
      "$comment": "interface 级 agent 定义（含旧别名 agent_name/interface_name/clk）",
      "type": "object",
      "anyOf": [
        { "required": ["name"] },
        { "required": ["agent_name"] }
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "agent_name": { "type": "string" },
        "interface": { "type": "string" },
        "interface_name": { "type": "string" },
        "clock": { "type": "string" },
        "clk": { "type": "string" },
        "reset": { "type": "string" },
        "protocol": { "$comment": "协议名不做 enum（semantic_check 只特判 apb，新协议合法）", "type": "string" },
        "reset_active_low": { "$ref": "#/$defs/boolLike" },
        "is_active": { "$ref": "#/$defs/isActive" },
        "type": { "$comment": "→ agent_type", "type": "string" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "value": {}
            },
            "additionalProperties": false
          }
        },
        "hdl_typedefs": { "type": "array" },
        "hvl_typedefs": { "type": "array" },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/port" }
        },
        "transaction_vars": {
          "type": "array",
          "items": { "$ref": "#/$defs/transactionVar" }
        },
        "transaction_constraints": {
          "$comment": "list（旧，全归 master）或 {master, slave} dict（gen_uvm.py:571-578）",
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/namedValue" } },
            {
              "type": "object",
              "properties": {
                "master": { "type": "array", "items": { "$ref": "#/$defs/namedValue" } },
                "slave": { "type": "array", "items": { "$ref": "#/$defs/namedValue" } }
              },
              "additionalProperties": false
            }
          ]
        },
        "config_vars": { "type": "array" },
        "config_constraints": { "type": "array" },
        "response_info": { "type": "object" },
        "config": {
          "$comment": "旧读取路径 config.is_active（gen_uvm.py:546-553）；其余键自由透传",
          "type": "object",
          "properties": { "is_active": { "$ref": "#/$defs/isActive" } }
        },
        "custom_drive_logic": { "type": "string" },
        "custom_sample_logic": { "type": "string" },
        "custom_collect_logic": { "type": "string" },
        "custom_code": {
          "$comment": "pragma custom 区域槽 {slot: 代码}，槽名自由",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "interfaceArray": {
      "oneOf": [
        { "$ref": "#/$defs/interface" },
        { "type": "array", "items": { "$ref": "#/$defs/interface" } }
      ]
    },
    "port": {
      "type": "object",
      "required": ["name", "dir"],
      "properties": {
        "name": { "type": "string" },
        "dir": { "$comment": "模板按 dir 分支；拼错会静默退化为默认行为", "enum": ["input", "output"] },
        "width": { "$comment": "位宽：整数或参数名（如 ADDR_WIDTH）", "type": ["integer", "string"] }
      },
      "additionalProperties": false
    },
    "transactionVar": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "iscompare": { "$ref": "#/$defs/boolLike" },
        "isrand": { "$ref": "#/$defs/boolLike" },
        "is_master": { "$ref": "#/$defs/boolLike" }
      },
      "additionalProperties": false
    },
    "namedValue": {
      "$comment": "transaction_constraints 条目 {name, value}",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "anyOf": [
        { "required": ["name"] },
        { "required": ["env_name"] }
      ],
      "properties": {
        "name": { "type": "string" },
        "env_name": { "type": "string" },
        "agents": {
          "$comment": "list / dict-of-dict / dict-of-string（_normalize_agents_list, gen_uvm.py:1667）",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/envAgentEntry" },
                  { "anyOf": [{ "required": ["name"] }, { "required": ["type"] }] }
                ]
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  { "$ref": "#/$defs/envAgentEntry" },
                  { "type": "string" }
                ]
              }
            }
          ]
        },
        "subenvs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "interface": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "vipenvs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "vip_path": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "predictors": {
          "type": "array",
          "items": { "$ref": "#/$defs/predictorEntry" }
        },
        "scoreboards": {
          "type": "array",
          "items": { "$ref": "#/$defs/scoreboardEntry" }
        },
        "analysis_components": {
          "type": "array",
          "items": { "$ref": "#/$defs/analysisComponentEntry" }
        },
        "analysis_exports": {
          "type": "array",
          "items": { "$ref": "#/$defs/analysisPortEntry" }
        },
        "analysis_ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/analysisPortEntry" }
        },
        "virtual_sequencer": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "additionalProperties": false
        },
        "clk_rst_vip": { "$ref": "#/$defs/clkRstVip" },
        "clk_rst": { "$comment": "旧别名：缺 enabled，被包装为 clk_rst_vip（gen_uvm.py:2010-2016）", "$ref": "#/$defs/clkRst" },
        "register_model": { "$ref": "#/$defs/registerModel" },
        "reg_adapter": { "$comment": "旧别名（gen_uvm.py:2020）", "$ref": "#/$defs/registerModel" },
        "custom_code": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "harness_connect": {
          "$comment": "缺 path 时 set_vifs 无法渲染（semantic_check:152 同条件）",
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string" },
            "env_suffix": { "type": "string" }
          },
          "additionalProperties": false
        },
        "coverage_crosses": {
          "$comment": "内层 minItems:2 对应 gen_uvm.py:2040 的 len>=2 过滤",
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2
          }
        },
        "config_vars": { "type": "array" },
        "config_constraints": { "type": "array" },
        "tlm_connections": {
          "type": "array",
          "items": { "$ref": "#/$defs/tlmConnection" }
        },
        "bench": { "$comment": "旧透传（示例为显式空对象）", "type": "object" }
      },
      "additionalProperties": false
    },
    "envAgentEntry": {
      "$comment": "env 级 agent 实例条目（list 格式需 name 或 type 之一，见调用处 allOf）",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "interface": { "type": "string" },
        "clock": { "type": "string" },
        "reset": { "type": "string" },
        "instance": { "type": "string" },
        "config_db_path": { "type": "string" },
        "is_master": { "$ref": "#/$defs/boolLike" },
        "is_active": { "$ref": "#/$defs/boolLike" },
        "active": { "$comment": "AgentModel.active（gen_uvm.py:536）", "$ref": "#/$defs/boolLike" },
        "connections": { "type": "array" },
        "priority": { "$comment": "virtual_sequencer 仲裁（模板 default(5)）", "type": "integer" },
        "weight": { "$comment": "virtual_sequencer 权重（模板 default(1)）", "type": "integer" }
      },
      "additionalProperties": false
    },
    "predictorEntry": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "in_type": { "type": "string" },
        "out_type": { "type": "string" },
        "input_from": { "type": "string" },
        "in_port": { "type": "string" },
        "out_port": { "type": "string" },
        "model_state": { "type": "string" },
        "model_body": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scoreboardEntry": {
      "$comment": "UVMF 新格式（sb_type/trans_type）与旧格式（mode/item_type/...）并集；mode 非法值被静默回退 inorder（gen_uvm.py:1641-1643），enum 拦截",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "sb_type": { "type": "string" },
        "trans_type": { "type": "string" },
        "mode": { "enum": ["inorder", "outoforder"] },
        "item_type": { "type": "string" },
        "key_field": { "type": "string" },
        "expected_from": { "type": "string" },
        "actual_from": { "type": "string" }
      },
      "additionalProperties": false
    },
    "analysisComponentEntry": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" }
      },
      "additionalProperties": false
    },
    "analysisPortEntry": {
      "$comment": "env 级 analysis_exports/ports 条目（type 兼容 trans_type，缺省 uvm_sequence_item）",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "trans_type": { "type": "string" },
        "connected_to": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tlmConnection": {
      "type": "object",
      "required": ["driver", "receiver"],
      "properties": {
        "driver": { "type": "string" },
        "receiver": { "type": "string" }
      },
      "additionalProperties": false
    },
    "clockList": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/clockSpec" }
        ]
      }
    },
    "resetList": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/resetSpec" }
        ]
      }
    },
    "clockSpec": {
      "$comment": "字段并集 = bench ClkSpec（period/init, gen_uvm.py:806）与 env clk_rst_vip 示例（period_ps/...）",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "period": { "type": "string" },
        "init": { "type": "integer" },
        "period_ps": { "type": "integer" },
        "duty_cycle": { "type": "number" },
        "initial_value": { "type": "integer" },
        "jitter_ps": { "type": "number" }
      },
      "additionalProperties": false
    },
    "resetSpec": {
      "$comment": "字段并集 = bench RstSpec（init/release_delay, gen_uvm.py:817）与 env 示例（assert_cycles/...）",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "init": { "type": "integer" },
        "release_delay": { "type": "integer" },
        "assert_cycles": { "type": "integer" },
        "recover_cycles": { "type": "integer" },
        "active_low": { "type": "boolean" },
        "reset_type": { "type": "string" }
      },
      "additionalProperties": false
    },
    "clkRst": {
      "type": "object",
      "properties": {
        "clocks": { "$ref": "#/$defs/clockList" },
        "resets": { "$ref": "#/$defs/resetList" }
      },
      "additionalProperties": false
    },
    "clkRstVip": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "clocks": { "$ref": "#/$defs/clockList" },
        "resets": { "$ref": "#/$defs/resetList" }
      },
      "additionalProperties": false
    },
    "harnessArray": {
      "oneOf": [
        { "$ref": "#/$defs/harness" },
        { "type": "array", "items": { "$ref": "#/$defs/harness" } }
      ]
    },
    "harness": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "bind_to": { "type": "string" },
        "parameter": { "type": "string" },
        "connect_path": { "type": "string" },
        "dut_instance": { "type": "string" },
        "interfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/harnessInterface" }
        },
        "sub_harnesses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "env_path": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "connect": {
          "$comment": "旧别名（gen_uvm.py:754）",
          "type": "object",
          "properties": { "path": { "type": "string" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "harnessInterface": {
      "$comment": "缺 name/type 会被 _normalize_harness 静默丢弃（gen_uvm.py:730）——本 schema 的核心拦截点",
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "agent_path": { "type": "string" },
        "bind_to": { "type": "string" },
        "source_path": { "type": "string" },
        "count": { "$comment": "整数或参数名（_to_count, gen_uvm.py:711）", "type": ["integer", "string"] },
        "connections": {
          "$comment": "端口名 → 信号名映射，键名自由",
          "type": "object",
          "additionalProperties": { "type": ["string", "integer", "boolean"] }
        }
      },
      "additionalProperties": false
    },
    "bench": {
      "type": "object",
      "anyOf": [
        { "required": ["name"] },
        { "required": ["bench_name"] }
      ],
      "properties": {
        "name": { "type": "string" },
        "bench_name": { "type": "string" },
        "env_name": { "type": "string" },
        "timeout": { "type": "string" },
        "include_assertions": { "$ref": "#/$defs/boolLike" },
        "dut_instance": { "type": "string" },
        "clk_rst": { "$ref": "#/$defs/clkRst" },
        "wire_decls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "width": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lhs", "rhs"],
            "properties": {
              "lhs": { "type": "string" },
              "rhs": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "agents": {
          "$comment": "list / dict 两种格式（_normalize_agents_list）；list 条目缺 name 被跳过（gen_uvm.py:2053-2055）",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/benchAgentEntry" },
                  { "required": ["name"] }
                ]
              }
            },
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/benchAgentEntry" }
            }
          ]
        },
        "harness": { "$comment": "嵌套 harness 会被二次解析（gen_uvm.py:2186-2191）", "$ref": "#/$defs/harness" },
        "uvm_config": { "type": "object" },
        "wave_dump": { "type": "object" },
        "simulation": { "type": "object" }
      },
      "additionalProperties": false
    },
    "benchAgentEntry": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "interface": { "type": "string" },
        "clock": { "type": "string" },
        "reset": { "type": "string" },
        "instance": { "type": "string" },
        "config_db_path": { "type": "string" },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["port", "wire"],
            "properties": {
              "port": { "type": "string" },
              "wire": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "registerModel": {
      "$comment": "list 条目走 regModelEntry；dict 形式（reg_adapter 嵌套 / reg_block_class 旧格式）宽松透传（gen_uvm.py:1833-1936）",
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/regModelEntry" } },
        { "type": "object" }
      ]
    },
    "regModelEntry": {
      "type": "object",
      "properties": {
        "bus_name": { "type": "string" },
        "type": { "type": "string" },
        "reg_block_name": { "type": "string" },
        "reg_adpater_name": { "type": "string" },
        "reg_adapter_name": { "type": "string" },
        "predictor_name": { "type": "string" },
        "trans_type": { "type": "string" },
        "name": { "type": "string" },
        "pkg": { "type": "string" },
        "role": { "type": "string" }
      },
      "additionalProperties": false
    },
    "constraintDoc": {
      "$comment": "name 缺省 \"constraint\"（gen_uvm.py:2085），不强制",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "constraint_name": { "type": "string" },
        "env_name": { "type": "string" },
        "env": { "type": "string" }
      },
      "additionalProperties": false
    },
    "transactions": {
      "$comment": "constraint 文件的顶层兄弟键（parse_constraint_model 吃整个文件 dict）",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "integer" },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "default": {}
              },
              "additionalProperties": false
            }
          },
          "applies_to": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "combinator": {
      "type": "object",
      "properties": {
        "default_mode": { "enum": ["APPLY_ALL", "APPLY_WEIGHTED", "APPLY_FIRST_MATCH", "APPLY_SEQUENTIAL", "APPLY_CHAIN"] },
        "modes": {
          "type": "array",
          "items": { "enum": ["APPLY_ALL", "APPLY_WEIGHTED", "APPLY_FIRST_MATCH", "APPLY_SEQUENTIAL", "APPLY_CHAIN"] }
        }
      },
      "additionalProperties": false
    },
    "utilComponent": {
