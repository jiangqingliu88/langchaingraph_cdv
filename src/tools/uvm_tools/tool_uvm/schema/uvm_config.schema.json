{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signoffai.local/tool_uvm/uvm_config.schema.json",
  "title": "tool_uvm YAML config",
  "description": "tool_uvm 的 YAML 配置契约（一个文件 = 一个文档）。键名/类型/必填/枚举校验；严重度由 schema_check.py 按 validator 映射（unknown key → warning，其余 → error）。",
  "type": "object",
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "interfaces": {
      "$ref": "#/$defs/interfaceArray"
    },
    "interface": {
      "$ref": "#/$defs/interfaceArray"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "bench": {
      "$ref": "#/$defs/bench"
    },
    "constraint": {
      "$ref": "#/$defs/constraintDoc"
    },
    "sc_pred": {
      "$ref": "#/$defs/scPred"
    },
    "rtl_sc_components": {
      "$ref": "#/$defs/scPred"
    },
    "transactions": {
      "$ref": "#/$defs/transactions"
    },
    "policies": {
      "$ref": "#/$defs/policies"
    },
    "combinator": {
      "$ref": "#/$defs/combinator"
    },
    "harness": {
      "$ref": "#/$defs/harnessArray"
    },
    "util_components": {
      "oneOf": [
        {
          "$ref": "#/$defs/utilComponent"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/utilComponent"
          }
        }
      ]
    },
    "cov_bins": {
      "$comment": "env_cov_bins.yaml —— 策略包的语义覆盖率 bin（gen_uvm 渲染 env_cov 时生成语义化 cross）",
      "oneOf": [
        {
          "$ref": "#/$defs/covBin"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/covBin"
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "$comment": "文书出处：这份 yaml 是从哪个库/哪一行抽出来的。**不参与生成**，给人看与审计用；`status` 是诚实标记（draft = 该版模型还没验证过）。",
      "properties": {
        "registry": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "integer",
            "string"
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "anyOf": [
    {
      "required": [
        "interfaces"
      ]
    },
    {
      "required": [
        "interface"
      ]
    },
    {
      "required": [
        "environment"
      ]
    },
    {
      "required": [
        "bench"
      ]
    },
    {
      "required": [
        "constraint"
      ]
    },
    {
      "required": [
        "sc_pred"
      ]
    },
    {
      "required": [
        "rtl_sc_components"
      ]
    },
    {
      "required": [
        "harness"
      ]
    },
    {
      "required": [
        "util_components"
      ]
    },
    {
      "required": [
        "cov_bins"
      ]
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "meta": {
      "$comment": "文件头元数据：键名自由，值仅限标量（gen_uvm.py:2125 对值做 str()）",
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "boolLike": {
      "$comment": "YAML 布尔或 \"True\"/\"False\"/\"yes\"/\"no\"/\"1\"/\"0\" 字符串（_opt_bool, gen_uvm.py:697）",
      "type": [
        "boolean",
        "string"
      ]
    },
    "isActive": {
      "$comment": "env 级 agent 实例的激活模式（_opt_bool → AgentModel.active，gen_uvm.py）；缺省 UVM_ACTIVE。interface 级已不再接受该键。",
      "oneOf": [
        {
          "$ref": "#/$defs/boolLike"
        },
        {
          "type": "object",
          "properties": {
            "master": {
              "$ref": "#/$defs/boolLike"
            },
            "slave": {
              "$ref": "#/$defs/boolLike"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scPred": {
      "$comment": "SC Pred 文档（gen_uvm.py parse_sc_pred_model；rtl_sc_components 为旧别名）。只列解析器实际读取的键，其余键报错而非静默忽略。",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "prod_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scPredPoint"
          }
        },
        "chck_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scPredPoint"
          }
        }
      },
      "additionalProperties": false
    },
    "scPredPoint": {
      "$comment": "SC Pred 观测点；缺 point_name 会被解析器丢弃",
      "type": "object",
      "required": [
        "point_name"
      ],
      "properties": {
        "point_name": {
          "type": "string"
        },
        "width": {
          "type": [
            "integer",
            "string"
          ]
        },
        "channel_num": {
          "type": [
            "integer",
            "string"
          ]
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        }
      },
      "additionalProperties": false
    },
    "interface": {
      "$comment": "interface 级 agent 定义（含旧别名 agent_name/interface_name/clk）",
      "type": "object",
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "agent_name"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "agent_name": {
          "type": "string"
        },
        "interface_name": {
          "type": "string"
        },
        "clock": {
          "type": "string"
        },
        "clk": {
          "type": "string"
        },
        "reset": {
          "type": "string"
        },
        "protocol": {
          "$comment": "协议名不做 enum（semantic_check 只特判 apb，新协议合法）",
          "type": "string"
        },
        "reset_active_low": {
          "$ref": "#/$defs/boolLike"
        },
        "type": {
          "$comment": "→ agent_type",
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "value": {}
            },
            "additionalProperties": false
          }
        },
        "typedefs": {
          "$comment": "类型别名 list：每项 { type_t: 类型表达式, type_name: 新类型名 }，渲染进 <name>_typedefs_pkg",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type_t",
              "type_name"
            ],
            "properties": {
              "type_t": {
                "type": "string"
              },
              "type_name": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "base_transaction_vars": {
          "$comment": "master/slave 共用的事务字段 —— 渲染进 <name>_base_seq_item，两侧 seq_item 继承它",
          "type": "array",
          "items": {
            "$ref": "#/$defs/transactionVar"
          }
        },
        "base_transaction_constraints": {
          "$comment": "master/slave 共用的约束 —— 渲染进 <name>_base_seq_item",
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedValue"
          }
        },
        "transaction_vars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transactionVar"
          }
        },
        "transaction_constraints": {
          "$comment": "list（旧，全归 master）或 {master, slave} dict（gen_uvm.py:571-578）",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/namedValue"
              }
            },
            {
              "type": "object",
              "properties": {
                "master": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/namedValue"
                  }
                },
                "slave": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/namedValue"
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "config_vars": {
          "type": "array"
        },
        "config_constraints": {
          "type": "array"
        },
        "response_info": {
          "type": "object"
        },
        "config": {
          "$comment": "自由透传的配置包（AgentModel.config，gen_uvm.py）；is_active 已下线，写在这里会被显式报错而非静默忽略",
          "type": "object",
          "not": {
            "required": [
              "is_active"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "interfaceArray": {
      "oneOf": [
        {
          "$ref": "#/$defs/interface"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          }
        }
      ]
    },
    "port": {
      "type": "object",
      "required": [
        "name",
        "dir"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "dir": {
          "$comment": "模板按 dir 分支；拼错会静默退化为默认行为",
          "enum": [
            "input",
            "output"
          ]
        },
        "width": {
          "$comment": "位宽：整数或参数名（如 ADDR_WIDTH）",
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "additionalProperties": false
    },
    "transactionVar": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "iscompare": {
          "$ref": "#/$defs/boolLike"
        },
        "isrand": {
          "$ref": "#/$defs/boolLike"
        },
        "is_master": {
          "$ref": "#/$defs/boolLike"
        }
      },
      "additionalProperties": false
    },
    "namedValue": {
      "$comment": "transaction_constraints 条目 {name, value}",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "agents": {
          "$comment": "list / dict-of-dict / dict-of-string（_normalize_agents_list, gen_uvm.py:1667）",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/envAgentEntry"
                  },
                  {
                    "$comment": "list 格式：name 或 type 至少写一个（另一个可推导）",
                    "anyOf": [
                      {
                        "required": [
                          "name"
                        ]
                      },
                      {
                        "required": [
                          "type"
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/envAgentEntry"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          ]
        },
        "subenvs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "interface": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "vipenvs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "vip_path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "scoreboards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scoreboardEntry"
          }
        },
        "analysis_components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisComponentEntry"
          }
        },
        "analysis_exports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisPortEntry"
          }
        },
        "analysis_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisPortEntry"
          }
        },
        "clk_rst_vip": {
          "$ref": "#/$defs/clkRstVip"
        },
        "clk_rst": {
          "$comment": "旧别名：缺 enabled，被包装为 clk_rst_vip（gen_uvm.py:2010-2016）",
          "$ref": "#/$defs/clkRst"
        },
        "register_model": {
          "$ref": "#/$defs/registerModel"
        },
        "reg_adapter": {
          "$comment": "旧别名（gen_uvm.py:2020）",
          "$ref": "#/$defs/registerModel"
        },
        "harness_connect": {
          "$comment": "缺 path 时 set_vifs 无法渲染（semantic_check:152 同条件）",
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "env_suffix": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "coverage_crosses": {
          "$comment": "内层 minItems:2 对应 gen_uvm.py:2040 的 len>=2 过滤",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          }
        },
        "config_vars": {
          "type": "array"
        },
        "config_constraints": {
          "type": "array"
        },
        "tlm_connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tlmConnection"
          }
        },
        "bench": {
          "$comment": "旧透传（示例为显式空对象）",
          "type": "object"
        },
        "tests": {
          "$comment": "属性测试：**一条 = 一个 UVM_TEST = 一个属性取值**（维度×取值）。渲染在 test_attr.sv.j2；内容为空时不产该文件",
          "type": "array",
          "items": {
            "$ref": "#/$defs/envTest"
          }
        }
      },
      "additionalProperties": false
    },
    "envTest": {
      "$comment": "一个属性测试。dimension/value 必填；key（uvm_config_db 通道名，ASCII）与 int_value（机器可读镜像）缺省时由模板过滤器推；base 缺省 {env_name}_gen_test。取值 token 可以是中文——它只进注释与类名投影，不进 SV 字面量",
      "type": "object",
      "required": [
        "dimension",
        "value"
      ],
      "properties": {
        "dimension": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "key": {
          "$comment": "config_db 键前缀；实际键是 <key>_int / <key>_str",
          "type": "string"
        },
        "int_value": {
          "type": "integer"
        },
        "base": {
          "$comment": "被继承的测试基类",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "envAgentEntry": {
      "$comment": "env 级 agent 实例条目（list 格式需 name 或 type 之一，见调用处 allOf）。type = agent 类名，从 YAML 显式读，不由 interface 拼接",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "clock": {
          "type": "string"
        },
        "reset": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "config_db_path": {
          "type": "string"
        },
        "is_master": {
          "$ref": "#/$defs/boolLike"
        },
        "is_active": {
          "$ref": "#/$defs/boolLike"
        },
        "active": {
          "$comment": "AgentModel.active（gen_uvm.py:536）",
          "$ref": "#/$defs/boolLike"
        },
        "connections": {
          "type": "array"
        },
        "priority": {
          "$comment": "virtual_sequencer 仲裁（模板 default(5)）",
          "type": "integer"
        },
        "weight": {
          "$comment": "virtual_sequencer 权重（模板 default(1)）",
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "scoreboardEntry": {
      "$comment": "scoreboard 条目：sb_type 指向外部类（生成式 mode/expected_from/actual_from 已下线）。sb_type 是参数化类时用 params 传实参，模板会 typedef 出别名再声明句柄",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sb_type": {
          "type": "string"
        },
        "trans_type": {
          "type": "string"
        },
        "params": {
          "$comment": "参数化类的实参列表，渲染成 typedef <sb_type>#(<params>) <name>_t;",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "analysisComponentEntry": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "analysisPortEntry": {
      "$comment": "env 级 analysis_exports/ports 条目（type 兼容 trans_type，缺省 uvm_sequence_item）",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "trans_type": {
          "type": "string"
        },
        "connected_to": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tlmConnection": {
      "type": "object",
      "required": [
        "driver",
        "receiver"
      ],
      "properties": {
        "driver": {
          "type": "string"
        },
        "receiver": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "clockList": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/clockSpec"
          }
        ]
      }
    },
    "resetList": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/resetSpec"
          }
        ]
      }
    },
    "clockSpec": {
      "$comment": "字段并集 = bench ClkSpec（period/init, gen_uvm.py:806）与 env clk_rst_vip 示例（period_ps/...）",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "init": {
          "type": "integer"
        },
        "period_ps": {
          "type": "integer"
        },
        "duty_cycle": {
          "type": "number"
        },
        "initial_value": {
          "type": "integer"
        },
        "jitter_ps": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "resetSpec": {
      "$comment": "字段并集 = bench RstSpec（init/release_delay, gen_uvm.py:817）与 env 示例（assert_cycles/...）",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "init": {
          "type": "integer"
        },
        "release_delay": {
          "type": "integer"
        },
        "assert_cycles": {
          "type": "integer"
        },
        "recover_cycles": {
          "type": "integer"
        },
        "active_low": {
          "type": "boolean"
        },
        "reset_type": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "clkRst": {
      "type": "object",
      "properties": {
        "clocks": {
          "$ref": "#/$defs/clockList"
        },
        "resets": {
          "$ref": "#/$defs/resetList"
        }
      },
      "additionalProperties": false
    },
    "clkRstVip": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clocks": {
          "$ref": "#/$defs/clockList"
        },
        "resets": {
          "$ref": "#/$defs/resetList"
        }
      },
      "additionalProperties": false
    },
    "harnessArray": {
      "oneOf": [
        {
          "$ref": "#/$defs/harness"
        },
