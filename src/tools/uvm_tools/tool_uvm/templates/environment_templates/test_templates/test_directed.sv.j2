// Directed Test: {{ environment.env_name }}_directed_test
// 执行特定场景测试

class {{ environment.env_name }}_directed_test extends {{ environment.env_name }}_base_test;
  `uvm_component_utils({{ environment.env_name }}_directed_test)

  function new(string name = "{{ environment.env_name }}_directed_test", uvm_component parent);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    // 定向测试配置
{%- for agent in agents %}
    cfg.{{ agent.name }}_cfg.is_active = UVM_ACTIVE;
    cfg.{{ agent.name }}_cfg.has_coverage = 1'b0;
{%- endfor %}
  endfunction

  virtual task run_phase(uvm_phase phase);
    phase.raise_objection(this);

    // 在所有 Agent Sequencer 上启动定向序列
{%- for agent in agents %}
    begin
      {{ agent.name }}_directed_seq _seq;
      _seq = {{ agent.name }}_directed_seq::type_id::create("_seq");
      _seq.start(env.{{ agent.name }}_agent_h.sqr);
    end
{%- endfor %}

    phase.drop_objection(this);
  endtask

endclass : {{ environment.env_name }}_directed_test
