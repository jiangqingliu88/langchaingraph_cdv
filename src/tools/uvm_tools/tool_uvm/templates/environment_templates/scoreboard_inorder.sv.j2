{% include "base_templates/base_template.sv.j2" %}

// ============================================================
// In-Order Scoreboard: {{ scb.name }}
// ============================================================
// 渲染上下文 (context) 约定:
//   scb.name        (str)   scoreboard 类名 / 实例名，如 "dut_scb"
//   scb.item_type   (str)   事务类型，如 "apb_seq_item"（须具备 compare()）
//   scb.import_pkgs (list)  需要 import 的 agent package 列表
// ============================================================
// 语义:
//   expected_export ← reference model / predictor（期望值）
//   actual_export   ← monitor（实际值）
//   FIFO 顺序比对：expected 按入队顺序与 actual 一一对应，先到先比。
//   mismatch 或 actual 无对应 expected 时发 `uvm_error`，驱动仿真 FAIL。
// ============================================================

`ifndef {{ scb.name | upper }}_SCB_SV
`define {{ scb.name | upper }}_SCB_SV

import uvm_pkg::*;
`include "uvm_macros.svh"
{%- for pkg in scb.import_pkgs %}
import {{ pkg }}::*;
{%- endfor %}

// imp 后缀含类名，避免 -mfcu 下多 scoreboard 的 analysis_imp 类型冲突
`uvm_analysis_imp_decl(_expected_{{ scb.name }})
`uvm_analysis_imp_decl(_actual_{{ scb.name }})

class {{ scb.name }} extends uvm_scoreboard;
  `uvm_component_utils({{ scb.name }})

  // 双端口：expected 来自 reference model / predictor，actual 来自 monitor
  uvm_analysis_imp_expected_{{ scb.name }} #({{ scb.item_type }}, {{ scb.name }}) expected_export;
  uvm_analysis_imp_actual_{{ scb.name }}   #({{ scb.item_type }}, {{ scb.name }}) actual_export;

  // FIFO：期望值按发送顺序排队
  protected {{ scb.item_type }} expected_q[$];

  // 统计计数器
  protected int m_matched    = 0;   // 比对通过
  protected int m_mismatched = 0;   // 比对失败
  protected int m_total      = 0;   // 收到的 actual 总数
  protected int m_dropped    = 0;   // actual 无对应 expected（下溢）

  function new(string name = "{{ scb.name }}", uvm_component parent = null);
    super.new(name, parent);
    expected_export = new("expected_export", this);
    actual_export   = new("actual_export",   this);
  endfunction

  // ── Reference model / predictor 发来期望值 ──
  virtual function void write_expected_{{ scb.name }}({{ scb.item_type }} exp);
    {{ scb.item_type }} clone;
    if (!$cast(clone, exp.clone())) begin
      `uvm_error(get_type_name(), "expected clone 失败")
      return;
    end
    expected_q.push_back(clone);
  endfunction

  // ── Monitor 发来实际值 ──
  virtual function void write_actual_{{ scb.name }}({{ scb.item_type }} act);
    m_total++;
    if (expected_q.size() == 0) begin
      m_dropped++;
      `uvm_error(get_type_name(), $sformatf(
        "[INORDER] actual #%0d 无对应 expected（下溢）\n  act=%s",
        m_total, act.convert2string()))
      return;
    end

    begin
      {{ scb.item_type }} exp = expected_q.pop_front();
      if (exp.compare(act)) begin
        m_matched++;
        `uvm_info(get_type_name(), $sformatf("[PASS] #%0d matched", m_total), UVM_MEDIUM)
      end else begin
        m_mismatched++;
        `uvm_error(get_type_name(), $sformatf(
          "[FAIL] #%0d mismatched\n  exp=%s\n  act=%s",
          m_total, exp.convert2string(), act.convert2string()))
      end
    end
  endfunction

  // ── 汇总 + 未匹配 expected 告警 ──
  virtual function void report_phase(uvm_phase phase);
    super.report_phase(phase);
    `uvm_info(get_type_name(), $sformatf(
      "InOrder Scoreboard: total=%0d matched=%0d mismatched=%0d pending=%0d dropped=%0d",
      m_total, m_matched, m_mismatched, expected_q.size(), m_dropped), UVM_NONE)
    if (expected_q.size() > 0) begin
      `uvm_error(get_type_name(), $sformatf(
        "仍有 %0d 个 expected 未匹配（pending）", expected_q.size()))
    end
  endfunction

endclass : {{ scb.name }}

`endif // {{ scb.name | upper }}_SCB_SV
