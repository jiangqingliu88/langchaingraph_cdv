{% include "base_templates/base_template.sv.j2" %}

// Virtual Base Sequence: {{ environment.env_name }}_virtual_base_seq
// 增强版 - 支持仲裁、同步、超时控制

class {{ environment.env_name }}_virtual_base_seq extends uvm_sequence;
  `uvm_object_utils({{ environment.env_name }}_virtual_base_seq)

  {{ environment.env_name }}_config cfg;
  protected int m_started = 0;
  protected int m_completed = 0;
  
  // pragma custom field_decl begin
  // pragma custom field_decl end

  function new(string name = "{{ environment.env_name }}_virtual_base_seq");
    super.new(name);
  endfunction

  virtual task pre_body();
    if (!uvm_config_db#({{ environment.env_name }}_config)::get(get_sequencer(), "", "cfg", cfg))
      `uvm_fatal("VSEQ_CFG", "Config not set")
  endtask

  virtual task body();
    `uvm_info("VSEQ", "Virtual base seq body - override in derived", UVM_MEDIUM)
  endtask

{%- for agent in agents %}
  protected task start_{{ agent.name }}_sequence(uvm_sequence #({{ agent.name }}_seq_item) _s);
    m_started++;
    fork
      _s.start(get_sequencer());
    join_none
  endtask

  protected task send_{{ agent.name }}_random(int count = 1);
    {{ agent.name }}_random_seq _rs;
    _rs = {{ agent.name }}_random_seq::type_id::create("_rs");
    _rs.num_transactions = count;
    start_{{ agent.name }}_sequence(_rs);
  endtask

{%- endfor %}

  // pragma custom seq_body begin
  // pragma custom seq_body end

endclass : {{ environment.env_name }}_virtual_base_seq