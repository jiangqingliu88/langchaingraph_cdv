{% include "base_templates/base_template.sv.j2" %}
{% import "base_templates/field_macros.j2" as fm %}

// Environment Configuration: {{ environment.env_name }}_config
// 自动生成，不要手动修改

class {{ environment.env_name }}_config extends uvm_object;
{%- for var in config_vars %}
  rand {{ var.type }} {{ var.name }};
{%- endfor %}

  // 是否启用 scoreboard（默认开启；仅当存在 scoreboards 时 environment 才引用）
  bit has_scoreboard = 1;

{%- for cons in config_constraints %}
  constraint {{ cons.name }} {{ cons.value | safe }}
{%- endfor %}

  // Agent 配置数组
{%- for agent in agents %}
  {{ agent.config_type }} {{ agent.name }}_cfg;
{%- endfor %}

  // ── file 注册机制：字段注册进 factory（copy/compare/print/pack/config_db 自动化）──
  // **必须放在字段声明之后**：这些宏展开成引用各字段的方法体，放在声明之前
  // Questa 判「Undefined variable」（实测：port_config / seq_item 都栽在这儿）。
  `uvm_object_utils_begin({{ environment.env_name }}_config)
{%- for var in config_vars %}
    {{ fm.uvm_field(var) }}
{%- endfor %}
    `uvm_field_int(has_scoreboard, UVM_DEFAULT)
{%- for agent in agents %}
    `uvm_field_object({{ agent.name }}_cfg, UVM_DEFAULT)
{%- endfor %}
  `uvm_object_utils_end

  function new(string name = "{{ environment.env_name }}_config");
    super.new(name);
{%- for agent in agents %}
    {{ agent.name }}_cfg = {{ agent.config_type }}::type_id::create("{{ agent.name }}_cfg");
    {{ agent.name }}_cfg.port_kind = {{ 'MASTER' if agent.is_master is not false else 'SLAVE' }};
{%- endfor %}
  endfunction

  // 配置有效性检查
  virtual function void check_config();
    // TODO: 实现配置合法性检查
  endfunction

endclass : {{ environment.env_name }}_config