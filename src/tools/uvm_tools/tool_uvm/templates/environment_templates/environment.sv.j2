{% include "base_templates/base_template.sv.j2" %}

// Environment: {{ environment.env_name }}
// 自动生成，不要手动修改

class {{ environment.env_name }} extends uvm_env;
  `uvm_component_utils({{ environment.env_name }})
  `ifdef USE_SC_MODEL_CHECK
    {{ name }}_sc_pred_env {{ name }}_sc_pred;
  `endif
  // ═══════════════════════════════════════
  // 时钟复位 Agent（可多个）
  // ═══════════════════════════════════════
{%- if clk_rst_vip and clk_rst_vip.enabled %}
  {%- for clk in clk_rst_vip.clocks %}
  clk_rst_agent {{ clk.name }}_clk_rst_agent_h;
  // vif 句柄：tb_top 是唯一能实例化接口的地方，它把 virtual clk_rst_if 放进
  // config_db，本 env 取出来再转发给 clk_rst agent（见 build_phase）。
  // 不声明这个成员、直接写 `{{ clk.name }}_vif` 的话是 "Undefined variable"。
  virtual clk_rst_if {{ clk.name }}_vif;
  {%- endfor %}
{%- endif %}
  // 配置对象
  {{ environment.env_name }}_config cfg;

  // ── Register Model（RAL，可选，由 YAML register_model 列表决定）──
{%- if register_model %}
{%- for comp in register_model.components %}
{#- 成员名与类名可能**同名**（adapter 的 name/type 都是 apb_reg_adapter）——
    那样写出 `X X;` 之后，`X::type_id` 会解析到**成员**而不是类，
    报 "Class or package 'X' not found"。给成员加 _h 后缀避开。 #}
{%-   set mn = (comp.name ~ '_h') if comp.role == 'adapter' else comp.name %}
{%- if comp.role == 'predictor' %}
  uvm_reg_predictor #({{ comp.trans_type }}) {{ mn }};  // 预测器需要指定总线事务类型
{%- else %}
  {{ comp.type }} {{ mn }};
{%- endif %}
{%- endfor %}
{%- endif %}

  // Agent 实例
{%- for agent in agents %}
  {{ agent.agent_type }} {{ agent.name }}_agent_h;
{%- endfor %}

  // Sub-env 实例
{%- for subenv in subenvs %}
  {{ subenv.type }} {{ subenv.name }};
{%- endfor %}

  // VIP env 实例（外部 VIP 集成）
{%- for ve in vipenvs %}
  {{ ve.type }} {{ ve.name }};
{%- endfor %}

  // Analysis 组件（predictor 等）
{%- for comp in analysis_components %}
{%-   set mn = comp.name %}   {#- 这里的成员名与类名不同名，加 _h 只是多余 #}
  {{ comp.type }} {{ mn }};
{%- endfor %}

  // Scoreboard
{%- for sb in scoreboards %}
{%- if sb.typedef_decl %}
  {{ sb.typedef_decl }}     // 参数化类特化：<类>#(<params>) 的别名
{%- endif %}
  {{ sb.handle_type }} {{ sb.name }};
{%- endfor %}

  // 功能覆盖率模型（env 级，跨 agent covergroup）
  {{ environment.env_name }}_coverage env_cov;
  {{ environment.env_name }}_sim_end sim_end_h;   // 仿真自动结束组件（watchdog + auto finish）

  // TLM 连接
{%- for agent in agents %}
  uvm_analysis_port #({{ agent.seq_item_type }}) {{ agent.name }}_agent_ap;
{%- endfor %}

  // Analysis Exports / Ports（env 级 TLM 端口，由 YAML analysis_exports/analysis_ports 配置）
{%- for port in analysis_exports %}
  uvm_analysis_export #({{ port.type }}) {{ port.name }};   // 输入（外部 → 环境内部）
{%- endfor %}
{%- for port in analysis_ports %}
  uvm_analysis_port #({{ port.type }}) {{ port.name }};     // 输出（环境 → 外部）
{%- endfor %}
 // Sequencer 中央管理（virtual_sequencer 在 seq_pkg 中，env_pkg 不可直接引用）
  {{ environment.env_name }}_virtual_sequencer virtual_sqr;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);

    // 获取环境配置
    if (!uvm_config_db#({{ environment.env_name }}_config)::get(this, "", "cfg", cfg))
      `uvm_fatal("CFG", "Environment configuration not set")
{%- if clk_rst_vip and clk_rst_vip.enabled %}
{%-   for clk in clk_rst_vip.clocks %}
    if (!uvm_config_db#(virtual clk_rst_if)::get(this, "", "{{ clk.name }}_vif", {{ clk.name }}_vif))
      `uvm_fatal("NOVIF", "clk_rst_if {{ clk.name }}_vif 没从 config_db 传进来（tb_top 负责 set）")
{%-   endfor %}
{%- endif %}
  `ifdef USE_SC_MODEL_CHECK
    {{ name }}_sc_pred={{ name }}_sc_pred_env::type_id::create("{{ name }}_sc_pred", this);
  `endif
    // ─── 创建时钟复位 Agent ───
{%- if clk_rst_vip and clk_rst_vip.enabled %}
  {%- for clk in clk_rst_vip.clocks %}
    begin
      clk_rst_config {{ clk.name }}_clk_cfg;
      {{ clk.name }}_clk_cfg = clk_rst_config::type_id::create("{{ clk.name }}_clk_cfg");
      
      // 时钟配置
      {{ clk.name }}_clk_cfg.clk_period_ps    = {{ clk.period_ps | default(10000) }};
      {{ clk.name }}_clk_cfg.clk_duty_cycle   = {{ clk.duty_cycle | default(50) }};
      {{ clk.name }}_clk_cfg.clk_start_value  = {{ clk.initial_value | default(0) }};
      {{ clk.name }}_clk_cfg.clk_jitter_ps    = {{ clk.jitter_ps | default(0) }};
      
      // 找到对应的复位配置
      {%- for reset in clk_rst_vip.resets %}
        {%- if loop.first %}
      // 为 {{ clk.name }} 配置复位（使用第一个复位作为默认）
      {{ clk.name }}_clk_cfg.rst_assert_cycles = {{ reset.assert_cycles | default(10) }};
      {{ clk.name }}_clk_cfg.rst_recover_cycles = {{ reset.recover_cycles | default(5) }};
      // 注：原为 `{{ reset.active_low | lower }}` —— 渲染出小写的 true/false，
      // 而**那不是合法的 SystemVerilog**（SV 没有 true/false 字面量），
      // vlog 报 "Undefined variable: 'true'"。要用 1'b1 / 1'b0。
      {{ clk.name }}_clk_cfg.rst_active_low = {{ "1'b1" if reset.active_low else "1'b0" }};
      // 注：这里原来还有一行 `rst_cfg.reset_type = ASYNC_SYNC_DEASSERT;` —— **两边都不存在**：
      //   · `clk_rst_config` 里没有 `reset_type` 这个字段（只有 rst_active_low /
      //     rst_assert_cycles / rst_recover_cycles / rst_start_value）
      //   · `ASYNC_SYNC_DEASSERT` 也不是任何地方的枚举值，裸标识符 → "Undefined variable"
      // YAML 里写了 `reset_type:` 的话目前**是被忽略的** —— 要支持它，得先在
      // `clk_rst_config.svh` 里加字段与枚举，那是公共库的改动，不在这里顺手做。
        {%- endif %}
      {%- endfor %}
      
      {{ clk.name }}_clk_rst_agent_h = clk_rst_agent::type_id::create("{{ clk.name }}_clk_rst_agent_h", this);
      // cfg 走**精确路径**（agent 自己在 build_phase 里 get 这一份）。
      uvm_config_db#(clk_rst_config)::set(this, "{{ clk.name }}_clk_rst_agent_h", "cfg", {{ clk.name }}_clk_cfg);
      // vif 必须走**带 `.*` 的通配路径**：真正要 vif 的是 agent 底下的 drv / rst_drv / mon，
      // 它们的查找路径是 `..._clk_rst_agent_h.drv`。uvm_config_db 的 set 路径是当
      // **正则**用的（`*` → `.*`），写死 `"{{ clk.name }}_clk_rst_agent_h"` 只匹配**本级**，
      // 子组件一路 get 不到 → `uvm_fatal("[VIF] Clock interface not set")`。
      uvm_config_db#(virtual clk_rst_if)::set(this, "{{ clk.name }}_clk_rst_agent_h.*", "vif", {{ clk.name }}_vif);
    end
  {%- endfor %}
{%- endif %}
    // 创建 Agent 并设置配置
{%- for agent in agents %}
    {{ agent.name }}_agent_h = {{ agent.agent_type }}::type_id::create("{{ agent.name }}_agent_h", this);
    uvm_config_db#({{ agent.config_type }})::set(this, "{{ agent.name }}_agent_h", "cfg", cfg.{{ agent.name }}_cfg);
{%- endfor %}

    // ─── Register Model（RAL）创建 ───
{%- if register_model %}
{%- for comp in register_model.components %}
{#- 成员名与类名可能**同名**（adapter 的 name/type 都是 apb_reg_adapter）——
    那样写出 `X X;` 之后，`X::type_id` 会解析到**成员**而不是类，
    报 "Class or package 'X' not found"。给成员加 _h 后缀避开。 #}
{%-   set mn = (comp.name ~ '_h') if comp.role == 'adapter' else comp.name %}
{%- if comp.role == 'reg_block' %}
    {{ mn }} = {{ comp.type }}::type_id::create("{{ mn }}", this);
    {{ mn }}.build();       // 显式调用 build()
    {{ mn }}.lock_model();  // 锁定模型，防止后续修改
{%- elif comp.role == 'adapter' %}
    {{ mn }} = {{ comp.type }}::type_id::create("{{ mn }}", this);
{%- elif comp.role == 'predictor' %}
{%- if comp.type == 'uvm_reg_predictor' %}
    {{ mn }} = uvm_reg_predictor #({{ comp.trans_type }})::type_id::create("{{ mn }}", this);
{%- else %}
    {{ mn }} = {{ comp.type }}::type_id::create("{{ mn }}", this);
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if register_model.reg_block %}
    // reg model 暴露到 config_db（reg 自检序列等通过 "*" 获取）
    uvm_config_db#(uvm_reg_block)::set(this, "*", "reg_model", {{ register_model.reg_block.name }});
{%- endif %}
{%- endif %}

    // 创建 Sub-env
{%- for subenv in subenvs %}
    {{ subenv.name }} = {{ subenv.type }}::type_id::create("{{ subenv.name }}", this);
{%- endfor %}

    // 创建 VIP env
{%- for ve in vipenvs %}
    {{ ve.name }} = {{ ve.type }}::type_id::create("{{ ve.name }}", this);
{%- endfor %}

    // 创建 Analysis 组件
{%- for comp in analysis_components %}
{%-   set mn = comp.name %}
    {{ mn }} = {{ comp.type }}::type_id::create("{{ mn }}", this);
{%- endfor %}

    // 创建 Scoreboard
{%- for sb in scoreboards %}
    {{ sb.name }} = {{ sb.handle_type }}::type_id::create("{{ sb.name }}", this);
{%- endfor %}

    // 创建功能覆盖率模型（env_cov）
    env_cov = {{ environment.env_name }}_coverage::type_id::create("env_cov", this);

    // 创建仿真自动结束组件（watchdog + 全部 objection 清零后 $finish）
    sim_end_h = {{ environment.env_name }}_sim_end::type_id::create("sim_end_h", this);

    // 创建 Analysis Ports
{%- for agent in agents %}
    {{ agent.name }}_agent_ap = new("{{ agent.name }}_agent_ap", this);
{%- endfor %}

    // 创建 Analysis Exports / Ports
{%- for port in analysis_exports %}
    {{ port.name }} = new("{{ port.name }}", this);
{%- endfor %}
{%- for port in analysis_ports %}
    {{ port.name }} = new("{{ port.name }}", this);
{%- endfor %}

    // 创建 Virtual Sequencer（virtual_sequencer 在 seq_pkg 中，env_pkg 不可引用）
    virtual_sqr = {{ environment.env_name }}_virtual_sequencer::type_id::create("virtual_sqr", this);
    uvm_config_db#({{ environment.env_name }}_config)::set(this, "virtual_sqr", "cfg", cfg);

    // pragma custom build_logic begin
    // pragma custom build_logic end
  endfunction

  virtual function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);

    // 连接子 Sequencer 到 Virtual Sequencer（直接赋值，规避 config_db 时序/作用域问题）
{%- for agent in agents %}
    virtual_sqr.{{ agent.name }}_sqr = {{ agent.name }}_agent_h.sequencer;
{%- endfor %}

    // 连接 Agent Monitor 到 Analysis Ports
{%- for agent in agents %}
{%-   if agent.is_master is not false %}
    {{ agent.name }}_agent_h.monitor.master_mon_ap.connect({{ agent.name }}_agent_ap);
{%-   else %}
    {{ agent.name }}_agent_h.monitor.slave_mon_ap.connect({{ agent.name }}_agent_ap);
{%-   endif %}
{%- endfor %}

    // 连接 Analysis Ports 到功能覆盖率模型（env_cov）
{%- for agent in agents %}
    {{ agent.name }}_agent_ap.connect(env_cov.{{ agent.name }}_export);
{%- endfor %}

    // ─── Register Model（RAL）连接 ───
{%- if register_model and register_model.reg_block and register_model.bus_agent %}
    // 1. 将寄存器模型的地址映射（default_map）连接到序列器和适配器
    {{ register_model.reg_block.name }}.default_map.set_sequencer({{ register_model.bus_agent }}_agent_h.sequencer{% if register_model.adapter %}, {{ register_model.adapter.name }}_h{% endif %});
    {{ register_model.reg_block.name }}.default_map.set_auto_predict({{ 0 if register_model.predictor else 1 }});
{%- endif %}
{%- if register_model.predictor and register_model.reg_block and register_model.bus_agent %}
    // 2. 配置预测器（显式预测模式）
    {{ register_model.predictor.name }}.map = {{ register_model.reg_block.name }}.default_map;
{%- if register_model.adapter %}
    {{ register_model.predictor.name }}.adapter = {{ register_model.adapter.name }}_h;
{%- endif %}
    {{ register_model.bus_agent }}_agent_ap.connect({{ register_model.predictor.name }}.bus_in);
{%- endif %}

    // Analysis Ports 连接（connected_to）
{%- for port in analysis_ports %}
{%- if port.connected_to %}
    {{ port.name }}.connect({{ port.connected_to }});
{%- endif %}
{%- endfor %}
{%- for port in analysis_exports %}
{%- if port.connected_to %}
    {{ port.connected_to }}.connect({{ port.name }});
{%- endif %}
{%- endfor %}

    // TLM 连接（显式 driver → receiver）
{%- for conn in tlm_connections %}
    {{ conn.driver }}.connect({{ conn.receiver }});
{%- endfor %}

    // pragma custom connect_logic begin
    // pragma custom connect_logic end

  endfunction

  virtual function void end_of_elaboration_phase(uvm_phase phase);
    super.end_of_elaboration_phase(phase);
    // 打印环境拓扑
    `uvm_info("ENV_TOPOLOGY", "Environment {{ environment.env_name }} structure:", UVM_LOW)
{%- for agent in agents %}
    `uvm_info("ENV_TOPOLOGY", "  Agent: {{ agent.name }}_agent_h", UVM_LOW)
{%- endfor %}
{%- for sb in scoreboards %}
    `uvm_info("ENV_TOPOLOGY", "  Scoreboard: {{ sb.name }}", UVM_LOW)
{%- endfor %}
  endfunction

  function void start_of_simulation_phase(uvm_phase phase);
      super.start_of_simulation_phase(phase);
      `uvm_info(get_name(), "start_of_simulation_phase", UVM_LOW)
      // 显示 banner
      // 初始化统计
  endfunction
  task configure_phase(uvm_phase phase);
        super.configure_phase(phase);
        `uvm_info(get_name(), "configure_phase: start", UVM_MEDIUM)
        phase.raise_objection(this);
        phase.drop_objection(this);
  endtask
    
  task pre_reset_phase(uvm_phase phase);
      super.pre_reset_phase(phase);
      `uvm_info(get_name(), "pre_reset_phase", UVM_HIGH)
      phase.raise_objection(this);
      #100ns;
      phase.drop_objection(this);
  endtask
  
  task reset_phase(uvm_phase phase);
      super.reset_phase(phase);
      `uvm_info(get_name(), "reset_phase", UVM_HIGH)
      phase.raise_objection(this);
      // 施加复位
      #200ns;
      phase.drop_objection(this);
  endtask
  
  task main_phase(uvm_phase phase);
      super.main_phase(phase);
      `uvm_info(get_name(), "main_phase", UVM_LOW)
      phase.raise_objection(this);
      // 主要测试激励
      // ...
      phase.drop_objection(this);
  endtask
  
  task shutdown_phase(uvm_phase phase);
      super.shutdown_phase(phase);
      `uvm_info(get_name(), "shutdown_phase", UVM_HIGH)
      phase.raise_objection(this);
      #100ns;
      phase.drop_objection(this);
  endtask
  
  // ============================================================
  // Post-processing Phases (自底向上执行)
  // ============================================================
  
  function void extract_phase(uvm_phase phase);
      super.extract_phase(phase);
      `uvm_info(get_name(), "extract_phase", UVM_LOW)
      // 从组件提取最终数据
      // 收集计数器
  endfunction
  
  function void check_phase(uvm_phase phase);
      super.check_phase(phase);
      `uvm_info(get_name(), "check_phase", UVM_LOW)
      // 检查最终状态
      // 验证数据完整性
  endfunction
  //========================================================================
  // report_phase - 统计并打印图案
  //========================================================================
  function void report_phase(uvm_phase phase);
      uvm_report_server server;
      int error_count;
      int fatal_count;
      
      super.report_phase(phase);
      
      // 获取全局报告服务器
      server = uvm_report_server::get_server();
      
      // 获取错误和致命错误计数
      error_count = server.get_severity_count(UVM_ERROR);
      fatal_count = server.get_severity_count(UVM_FATAL);
      
      // 打印分隔线
      `uvm_info(get_name(), "\n", UVM_NONE)
      `uvm_info(get_name(), "================================================================================", UVM_NONE)
      
      // 根据结果打印图案
      if (error_count > 0 || fatal_count > 0) begin
          print_test_fail();
      end else begin
          print_test_pass();
      end
      
      `uvm_info(get_name(), "================================================================================", UVM_NONE)
      `uvm_info(get_name(), "\n", UVM_NONE)
      
  endfunction

  //========================================================================
  // TEST_PASS / TEST_FAIL 图案
  //
  // `_report_patterns.sv.j2` 里是**两个函数定义**（print_test_pass /
  // print_test_fail），所以它属于**类作用域** —— 放在 report_phase 的
  // `endfunction` **之后**才对。（别挪进 report_phase 里面：那会变成函数套函数。）
  //
  // 这里原来在 include 之后**还多跟了一个 `endfunction`** —— 渲染出来就是
  // 「类里凭空多一个 endfunction」，vlog 判 "near 'endfunction': syntax error"，
  // 而报错位置会指到几百行之外，很难往这儿联想。
  //========================================================================
{% include "environment_templates/_report_patterns.sv.j2" %}
  function void final_phase(uvm_phase phase);
      super.final_phase(phase);
      `uvm_info(get_name(), "final_phase", UVM_LOW)
      // 关闭文件
      // 最终清理
  endfunction
endclass : {{ environment.env_name }}