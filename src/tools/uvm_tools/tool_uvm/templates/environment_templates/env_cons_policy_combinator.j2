{% include "base_templates/base_template.sv.j2" %}

// {{ environment.env_name }}_policy_combinator.sv
// 自动生成的策略组合器

`include "{{ environment.env_name }}_constraint_policies.sv"

class {{ environment.env_name }}_policy_combinator extends {{ environment.env_name }}_constraint_policy;
  `uvm_object_utils({{ environment.env_name }}_policy_combinator)
  
  // 策略列表
  {{ environment.env_name }}_constraint_policy policies[$];
  
  // 组合模式
  typedef enum {
{% for mode in combinator.modes %}
    {{ mode }}{% if not loop.last %},{% endif %}
{% endfor %}
  } apply_mode_e;
  
  apply_mode_e apply_mode = {{ combinator.default_mode }};
  
  // 统计
  int apply_count[$];
  int verify_count[$];

  // **必须显式声明构造函数**：Questa 下派生类不写 `new` 时，
  // `uvm_object_utils` 里的 `new(name)` 会报
  // "Number of actuals and formals does not match"（实测最小复现）。
  function new(string name = "{{ environment.env_name }}_policy_combinator");
    super.new(name);
  endfunction

  function void add_policy({{ environment.env_name }}_constraint_policy policy);
    policies.push_back(policy);
    apply_count.push_back(0);
    verify_count.push_back(0);
  endfunction
  
  function void remove_policy(string policy_name);
    for (int i = 0; i < policies.size(); i++) begin
      if (policies[i].policy_name == policy_name) begin
        policies.delete(i);
        apply_count.delete(i);
        verify_count.delete(i);
        break;
      end
    end
  endfunction
  
  function {{ environment.env_name }}_constraint_policy get_policy(string policy_name);
    foreach (policies[i]) begin
      if (policies[i].policy_name == policy_name)
        return policies[i];
    end
    return null;
  endfunction
  
  virtual function void apply(ref {{ environment.env_name }}_policy_context ctx);
    // 按优先级排序
    sort_by_priority();
    
    case (apply_mode)
      APPLY_ALL: begin
        for (int i = 0; i < policies.size(); i++) begin
          if (policies[i].enabled) begin
            policies[i].apply(ctx);
            apply_count[i]++;
          end
        end
      end
      
      APPLY_WEIGHTED: begin
        int idx = select_weighted();
        if (idx >= 0) begin
          policies[idx].apply(ctx);
          apply_count[idx]++;
        end
      end
      
      APPLY_FIRST_MATCH: begin
        for (int i = 0; i < policies.size(); i++) begin
          if (policies[i].enabled && should_apply(i, ctx)) begin
            policies[i].apply(ctx);
            apply_count[i]++;
            break;
          end
        end
      end
      
      APPLY_SEQUENTIAL: begin
        {{ environment.env_name }}_policy_context temp_ctx = new();
        temp_ctx.copy(ctx);
        
        for (int i = 0; i < policies.size(); i++) begin
          if (policies[i].enabled) begin
            policies[i].apply(temp_ctx);
            apply_count[i]++;
          end
        end
        
        ctx.copy(temp_ctx);
      end
      
      APPLY_CHAIN: begin
        {{ environment.env_name }}_policy_context chain_ctx = new();
        chain_ctx.copy(ctx);
        
        for (int i = 0; i < policies.size(); i++) begin
          if (policies[i].enabled) begin
            {{ environment.env_name }}_policy_context output_ctx = new();
            output_ctx.copy(chain_ctx);
            policies[i].apply(output_ctx);
            apply_count[i]++;
            chain_ctx = output_ctx;
          end
        end
        
        ctx.copy(chain_ctx);
      end
    endcase
  endfunction
  
  virtual function bit verify(ref {{ environment.env_name }}_policy_context ctx);
    bit result = 1;
    for (int i = 0; i < policies.size(); i++) begin
      if (policies[i].enabled) begin
        if (!policies[i].verify(ctx)) begin
          `uvm_warning(get_name(), $sformatf("Policy %s verification failed",
                     policies[i].policy_name))
          result = 0;
        end
        verify_count[i]++;
      end
    end
    return result;
  endfunction
  
  function void sort_by_priority();
    // 声明全部放函数开头（SV：块内声明必须先于语句）
    {{ environment.env_name }}_constraint_policy temp_p;
    int temp_c;
    for (int i = 0; i < policies.size() - 1; i++) begin
      for (int j = 0; j < policies.size() - i - 1; j++) begin
        if (policies[j].policy_priority > policies[j+1].policy_priority) begin
          // 交换策略
          temp_p = policies[j];
          policies[j] = policies[j+1];
          policies[j+1] = temp_p;

          // 交换统计
          temp_c = apply_count[j];
          apply_count[j] = apply_count[j+1];
          apply_count[j+1] = temp_c;

          temp_c = verify_count[j];
          verify_count[j] = verify_count[j+1];
          verify_count[j+1] = temp_c;
        end
      end
    end
  endfunction
  
  function int select_weighted();
    int total_weight = 0;
    int rand_weight;
    int acc = 0;
    for (int i = 0; i < policies.size(); i++) begin
      if (policies[i].enabled)
        total_weight += policies[i].policy_priority;
    end

    if (total_weight == 0) return -1;

    rand_weight = $urandom_range(0, total_weight - 1);

    for (int i = 0; i < policies.size(); i++) begin
      if (policies[i].enabled) begin
        acc += policies[i].policy_priority;
        if (rand_weight < acc)
          return i;
      end
    end
    
    return -1;
  endfunction
  
  virtual function bit should_apply(int idx, ref {{ environment.env_name }}_policy_context ctx);
    // 可以基于上下文判断是否应用
    return 1;
  endfunction
  
  function void configure_from_plusargs();
    string mode_str;
    // 循环体内要用的变量**全部前置声明**（SV 不允许语句之后再声明）
    string disable_arg;
    string enable_arg;
    string priority_arg;
    int new_priority;
    if ($value$plusargs("{{ environment.env_name | upper }}_POLICY_MODE=%s", mode_str)) begin
      case (mode_str)
{% for mode in combinator.modes %}
        "{{ mode }}": apply_mode = {{ mode }};
{% endfor %}
      endcase
    end
    
    for (int i = 0; i < policies.size(); i++) begin
      policies[i].parse_plusargs();
      
      disable_arg = {"NO_", policies[i].policy_name};
      if ($test$plusargs(disable_arg))
        policies[i].disable_policy();

      enable_arg = {"ENABLE_", policies[i].policy_name};
      if ($test$plusargs(enable_arg))
        policies[i].enable_policy();

      priority_arg = {policies[i].policy_name, "_PRIORITY=%d"};
      if ($value$plusargs(priority_arg, new_priority))
        policies[i].policy_priority = new_priority;
    end
  endfunction
  
  function void report_stats();
    `uvm_info(get_name(), "========================================", UVM_NONE)
    `uvm_info(get_name(), "Policy Statistics:", UVM_NONE)
    for (int i = 0; i < policies.size(); i++) begin
      `uvm_info(get_name(), $sformatf("  %s: apply=%0d, verify=%0d, %s",
                 policies[i].policy_name, 
                 apply_count[i], 
                 verify_count[i],
                 policies[i].get_stats()), UVM_NONE)
    end
    `uvm_info(get_name(), "========================================", UVM_NONE)
  endfunction
endclass