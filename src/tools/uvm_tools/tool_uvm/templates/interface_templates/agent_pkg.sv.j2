// ============================================================
// Agent Package: {{ agent.name }}_pkg
// ============================================================
// 注意：{{ agent.name }}_if.sv（interface）须在 package 之前单独编译（见 filelist）
package {{ agent.name }}_pkg;
  import uvm_pkg::*;
  `include "uvm_macros.svh"

{%- for param in agent.parameters %}
  localparam {{ param.type }} {{ param.name }} = {{ param.value }};
{%- endfor %}
{%- if agent.hdl_typedefs %}
  // HDL type definitions (mirror interface typedefs)
{%-   for td in agent.hdl_typedefs %}
  typedef {{ td.type }} {{ td.name }};
{%-   endfor %}
{%- endif %}
{%- if agent.hvl_typedefs %}
  // HVL type definitions
{%-   for td in agent.hvl_typedefs %}
  typedef {{ td.type }} {{ td.name }};
{%-   endfor %}
{%- endif %}

  `include "2_config/{{ agent.name }}_master_config.sv"
  `include "2_config/{{ agent.name }}_slave_config.sv"
  `include "3_transaction_sequencer/{{ agent.name }}_master_seq_item.sv"
  `include "3_transaction_sequencer/{{ agent.name }}_slave_seq_item.sv"
  `include "3_transaction_sequencer/{{ agent.name }}_master_sequencer.sv"
  `include "3_transaction_sequencer/{{ agent.name }}_slave_sequencer.sv"
  `include "4_driver_monitor/{{ agent.name }}_master_driver.sv"
  `include "4_driver_monitor/{{ agent.name }}_slave_driver.sv"
  `include "4_driver_monitor/{{ agent.name }}_master_monitor.sv"
  `include "4_driver_monitor/{{ agent.name }}_slave_monitor.sv"
  `include "5_agent/{{ agent.name }}_master_agent.sv"
  `include "5_agent/{{ agent.name }}_slave_agent.sv"
  `include "5_agent/{{ agent.name }}_system_config.sv"
  `include "5_agent/{{ agent.name }}_system_env.sv"
  `include "7_sequence/{{ agent.name }}_master_sequence.sv"
  `include "7_sequence/{{ agent.name }}_slave_sequence.sv"
  `include "8_ral/{{ agent.name }}_reg_adapter.sv"

endpackage : {{ agent.name }}_pkg
