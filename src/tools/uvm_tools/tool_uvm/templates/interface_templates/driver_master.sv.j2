{% include "base_templates/base_template.sv.j2" %}

// ============================================================
// Master Driver Callback: {{ agent.name }}_master_driver_cb
// ============================================================
// UVM callback 扩展点：测试可派生本类插入自己的行为（改激励、注入错误、
// 记录时序），**无需改动 driver 本体**。
//
// 注册（test 的 build_phase）：
//   {{ agent.name }}_master_driver_cb cb;
//   cb = {{ agent.name }}_master_driver_cb::type_id::create("cb");
//   uvm_callbacks#({{ agent.name }}_master_driver,
//                  {{ agent.name }}_master_driver_cb)::add(drv, cb);
//
// 注：typedef class 是前置声明 —— callback 的方法签名要用到 driver 类型，
//     而 driver 定义在下方，SystemVerilog 要求先声明后使用。

typedef class {{ agent.name }}_master_driver;

class {{ agent.name }}_master_driver_cb extends uvm_callback;
  `uvm_object_utils({{ agent.name }}_master_driver_cb)

  function new(string name = "{{ agent.name }}_master_driver_cb");
    super.new(name);
  endfunction

  // 驱动前：可修改 req 字段（地址边界、错误注入、延迟调整等）
  virtual task pre_drive({{ agent.name }}_master_driver drv,
                         {{ agent.name }}_master_seq_item req);
  endtask

  // 驱动后：时序记录 / 协议检查
  virtual task post_drive({{ agent.name }}_master_driver drv,
                          {{ agent.name }}_master_seq_item req);
  endtask
endclass : {{ agent.name }}_master_driver_cb

// ============================================================
// Master Driver: {{ agent.name }}_master_driver
// ============================================================

class {{ agent.name }}_master_driver extends uvm_driver #({{ agent.name }}_master_seq_item);
  `uvm_component_utils({{ agent.name }}_master_driver)
  // 建立 driver 类型 ↔ callback 类型的回调池（uvm_do_callbacks 依赖它）
  `uvm_register_cb({{ agent.name }}_master_driver, {{ agent.name }}_master_driver_cb)

  virtual {{ agent.name }}_if vif;
  {{ agent.name }}_port_config cfg;
  // pragma custom field_decl begin
  // pragma custom field_decl end

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db#(virtual {{ agent.name }}_if)::get(this, "", "vif", vif))
      `uvm_fatal("NOVIF", "Virtual interface not set")
    if (!uvm_config_db#({{ agent.name }}_port_config)::get(this, "", "cfg", cfg))
      `uvm_fatal("CFG", "Config not set")
    // pragma custom build_logic begin
    // pragma custom build_logic end
  endfunction

  task configure_phase(uvm_phase phase);
    super.configure_phase(phase);
    `uvm_info(get_type_name(), "configure_phase: start", UVM_MEDIUM)
    phase.raise_objection(this);
    phase.drop_objection(this);
  endtask

  task main_phase(uvm_phase phase);
    super.main_phase(phase);
    `uvm_info(get_type_name(), "main_phase: start", UVM_MEDIUM)
    // driver 的 forever 循环不 raise objection（避免悬挂）；复位门控后才开始驱动
    wait (vif.{{ agent.reset }} == 1'b{{ 1 if agent.reset_active_low else 0 }});
    forever begin
      {{ agent.name }}_master_seq_item req;
      seq_item_port.get_next_item(req);
      drive_transaction(req);
      seq_item_port.item_done();
    end
  endtask

  virtual task drive_transaction({{ agent.name }}_master_seq_item req);
    // 回调：驱动前（可改 req）
    `uvm_do_callbacks({{ agent.name }}_master_driver, {{ agent.name }}_master_driver_cb,
                      pre_drive(this, req))
    // pragma custom drive_logic begin
{%- if agent.protocol == 'apb' %}
    // === APB 两拍时序: setup（addr/sel/write/data）→ access（penable）→ 等 pready → 撤拍 ===
    @(vif.master_cb);
    vif.master_cb.psel    <= 1'b1;
    vif.master_cb.paddr   <= req.paddr;
    vif.master_cb.pwrite  <= req.pwrite;
    vif.master_cb.pwdata  <= req.pwdata;
    @(vif.master_cb);
    vif.master_cb.penable <= 1'b1;
    do @(vif.master_cb); while (vif.master_cb.pready !== 1'b1);
    // **采样读数据 / 错误响应。** 这是**寄存器模型（RAL）唯一的数据来源**：
    // 适配器的 `bus2reg` 从**同一条 req** 上取 `prdata` / `pslverr`
    //（`provides_responses=0`，driver 不 put_response，就地写回）。
    // 不采的话，每一次寄存器读拿到的都是 seq_item 里那个未驱动的初值 ——
    // 复位值检查、bit_bash 全部失真，而且是"假通过 / 假失败"，不报错。
    if (!req.pwrite) begin
      req.prdata  = vif.master_cb.prdata;
      req.pslverr = vif.master_cb.pslverr;
    end
    vif.master_cb.penable <= 1'b0;
    vif.master_cb.psel    <= 1'b0;
{%- else %}
    // === Default: 将 is_rand=True 且映射到 output 端口的字段单拍驱动 ===
    repeat (cfg.drive_delay_max > 0 ? $urandom_range(cfg.drive_delay_min, cfg.drive_delay_max) : 0)
      @(vif.master_cb);
{%- for port in ports %}
{%-   if port.dir == 'output' %}
{%-     set port_in_txn = namespace(found=false) %}
{%-     for var in transaction_vars %}
{%-       if var.name == port.name %}{% set port_in_txn.found = true %}{% endif %}
{%-     endfor %}
{%-     if port_in_txn.found %}
    vif.master_cb.{{ port.name }} <= req.{{ port.name }};
{%-     endif %}
{%-   endif %}
{%- endfor %}
    @(vif.master_cb);
{%- endif %}
    // pragma custom drive_logic end
    // 回调：驱动后
    `uvm_do_callbacks({{ agent.name }}_master_driver, {{ agent.name }}_master_driver_cb,
                      post_drive(this, req))
  endtask
endclass : {{ agent.name }}_master_driver
