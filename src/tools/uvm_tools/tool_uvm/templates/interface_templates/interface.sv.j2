// 自动生成的 Interface: {{ name }}
interface {{ agent.name }}_interface #(
{%- for param in parameters %}
  parameter {{ param.type }} {{ param.name }} = {{ param.value }}{% if not loop.last %},{% endif %}
{%- endfor %}
) (
{%- for port in ports %}
  {%- set width_str = port.width|string %}
  {%- if port.dir == 'input' %}input  {% elif port.dir == 'output' %}output {% endif %}
  {%- if width_str == '1' %}logic{% else %}logic [{{ port.width }}-1:0]{% endif %} {{ port.name }}{% if not loop.last %},{% endif %}
{%- endfor %}
);

  // HDL 类型定义
{%- for td in hdl_typedefs %}
  typedef {{ td.type }} {{ td.name }};
{%- endfor %}

  // 时钟块
  clocking cb @(posedge {{ clock }});
{%- for port in ports %}
{%-   if port.name != clock and port.name != reset %}
    {%- if port.dir == 'output' %}output{% else %}input{% endif %} {{ port.name }};
{%-   endif %}
{%- endfor %}
  endclocking : cb

  // Modport
  modport mp (
    input  {{ clock }},
    input  {{ reset }},
{%- for port in ports %}
{%-   if port.name != clock and port.name != reset %}
    {%- if port.dir == 'output' %}output{% else %}input{% endif %} {{ port.name }},
{%-   endif %}
{%- endfor %}
    clocking cb
  );

  // 复位断言电平: {{ reset_assertion_level }} (可用于驱动逻辑)

endinterface : {{ agent.name }}_interface