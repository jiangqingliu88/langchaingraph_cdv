// ============================================================
// Slave Agent: {{ agent.name }}_slave_agent
// ============================================================

class {{ agent.name }}_slave_agent extends uvm_agent;
  `uvm_component_utils({{ agent.name }}_slave_agent)

  {{ agent.name }}_slave_sequencer sequencer;
  {{ agent.name }}_slave_driver    driver;
  {{ agent.name }}_slave_monitor   monitor;
  {{ agent.name }}_slave_config    cfg;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    uvm_config_db#({{ agent.name }}_slave_config)::get(this, "", "cfg", cfg);
    if (cfg == null)
      cfg = {{ agent.name }}_slave_config::type_id::create("cfg", this);

    monitor = {{ agent.name }}_slave_monitor::type_id::create("monitor", this);
    if (cfg.is_active == UVM_ACTIVE) begin
      sequencer = {{ agent.name }}_slave_sequencer::type_id::create("sequencer", this);
      driver    = {{ agent.name }}_slave_driver::type_id::create("driver", this);
    end
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    if (cfg.is_active == UVM_ACTIVE) begin
      driver.seq_item_port.connect(sequencer.seq_item_export);
      // ★ 将 Sequencer 句柄传给 Monitor（事件驱动）
      uvm_config_db#({{ agent.name }}_slave_sequencer)::set(this, "monitor", "sqr", sequencer);
    end
    uvm_config_db#(virtual {{ agent.name }}_if)::set(this, "monitor", "vif", cfg.vif);
    uvm_config_db#({{ agent.name }}_slave_config)::set(this, "monitor", "cfg", cfg);
    if (driver != null) begin
      uvm_config_db#(virtual {{ agent.name }}_if)::set(this, "driver", "vif", cfg.vif);
      uvm_config_db#({{ agent.name }}_slave_config)::set(this, "driver", "cfg", cfg);
    end
  endfunction
endclass : {{ agent.name }}_slave_agent
