// ============================================================
// Driver Callback
// ============================================================
typedef class {{ agent.name }}_driver;
typedef class {{ agent.name }}_sequencer;
class {{ agent.name }}_driver_callback extends uvm_callback;
  `uvm_object_utils({{ agent.name }}_driver_callback)

  function new(string name = "{{ agent.name }}_driver_callback");
    super.new(name);
  endfunction

  virtual function void on_pre_drive(
    {{ agent.name }}_driver driver,
    {{ agent.name }}_seq_item item
  );
  endfunction

  virtual function void on_post_drive(
    {{ agent.name }}_driver driver,
    {{ agent.name }}_seq_item item
  );
  endfunction

  virtual function void on_item_received(
    {{ agent.name }}_driver driver,
    {{ agent.name }}_seq_item item
  );
  endfunction

  virtual function void on_item_done(
    {{ agent.name }}_driver driver,
    {{ agent.name }}_seq_item item
  );
  endfunction

  virtual function void on_reset(
    {{ agent.name }}_driver driver
  );
  endfunction

  virtual function void on_idle(
    {{ agent.name }}_driver driver
  );
  endfunction

endclass : {{ agent.name }}_driver_callback

// ============================================================
// Driver: {{ agent.name }}_driver
// Loopback-safe: expected written INSIDE drive_transaction
// to avoid race with monitor sampling at the next clock edge.
// ============================================================

class {{ agent.name }}_driver extends uvm_driver #({{ agent.name }}_seq_item);
  `uvm_component_utils({{ agent.name }}_driver)
  `uvm_register_cb({{ agent.name }}_driver, {{ agent.name }}_driver_callback)

  virtual {{ agent.interface }}_interface vif;
  {{ agent.name }}_config cfg;

  // Loopback self-test port: Driver expected -> Scoreboard
  uvm_analysis_port #({{ agent.name }}_seq_item) expected_port;

  // --- Statistics ---
  protected int m_driven = 0;

  function new(string name, uvm_component parent);
    super.new(name, parent);
    expected_port = new("expected_port", this);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db #({{ agent.name }}_config)::get(this, "", "cfg", cfg))
      `uvm_fatal("CFG", "Config not set")
    if (!uvm_config_db #(virtual {{ agent.interface }}_interface)::get(this, "", "vif", vif))
      `uvm_fatal("NOVIF", "Virtual interface not set")
  endfunction

  // --- Reset ---
  virtual task reset_signals();
{%- for port in ports %}
{%-   if port.dir == 'output' %}
    vif.cb.{{ port.name }} <= 0;
{%-   endif %}
{%- endfor %}
  endtask

  // --- Main drive ---
  // Reset handled inline (reset_phase not auto-scheduled without objection)
  task run_phase(uvm_phase phase);
    reset_signals();
    @(posedge vif.{{ agent.reset }});
    get_and_drive();
  endtask

  // --- Receive and drive ---
  virtual task get_and_drive();
    {{ agent.name }}_seq_item req;
    forever begin
      seq_item_port.get_next_item(req);

      `uvm_do_callbacks({{ agent.name }}_driver, {{ agent.name }}_driver_callback,
                        on_pre_drive(this, req))

      apply_drive_delay();

      drive_transaction(req);

      `uvm_do_callbacks({{ agent.name }}_driver, {{ agent.name }}_driver_callback,
                        on_post_drive(this, req))

      seq_item_port.item_done();
    end
  endtask

  // --- Configurable delay ---
  virtual task apply_drive_delay();
    if (cfg.drive_delay_max > 0) begin
      int delay = $urandom_range(cfg.drive_delay_min, cfg.drive_delay_max);
      repeat(delay) @(vif.cb);
    end
  endtask

  // Drive transaction AND write expected to scoreboard INSIDE
  // to ensure expected arrives before monitor's next sample.
  // (custom_drive_logic placeholder filled by LLM with protocol timing)
  virtual task drive_transaction({{ agent.name }}_seq_item req);
    // Copy expected values from item BEFORE driving
    // Only copy fields that correspond to OUTPUT ports (TB drives these)
    {{ agent.name }}_seq_item exp = {{ agent.name }}_seq_item::type_id::create("exp");
{%- for var in transaction_vars %}
{%-   set is_output = namespace(found=false) %}
{%-   for port in ports %}
{%-     if port.dir == 'output' and port.name == var.name %}{% set is_output.found = true %}{% endif %}
{%-   endfor %}
{%-   if is_output.found %}
    exp.{{ var.name }} = req.{{ var.name }};
{%-   endif %}
{%- endfor %}

{% if agent.custom_drive_logic %}
    // === LLM-generated protocol timing ===
{{ agent.custom_drive_logic | indent(4, first=true) }}
{% else %}
    // === Default: simple @(cb) drive all output ports ===
    @(vif.cb);
    req.begin_time = $realtime;
{%- for port in ports %}
{%-   if port.dir == 'output' and port.name in ('valid', 'ready', 'psel', 'penable', 'strobe', 'enable') %}
    vif.cb.{{ port.name }} <= 1'b1;  // assert strobe
{%-   endif %}
{%- endfor %}
{%- for port in ports %}
{%-   if port.dir == 'output' %}
{%-     set port_in_txn = namespace(found=false) %}
{%-     for var in transaction_vars %}
{%-       if var.name == port.name %}{% set port_in_txn.found = true %}{% endif %}
{%-     endfor %}
{%-     if port_in_txn.found %}
    vif.cb.{{ port.name }} <= req.{{ port.name }};
{%-     endif %}
{%-   endif %}
{%- endfor %}
{% endif %}

    // Write expected NOW (before next @(vif.cb) where monitor samples)
    expected_port.write(exp);
    m_driven++;

    // Debug: print driven transaction
    `uvm_info("DRV", $sformatf("DRV: %s driven item #%0d:\n%s", get_name(), m_driven, req.sprint()), UVM_MEDIUM)

{%- set has_strobe = namespace(found=false) %}
{%- for port in ports %}
{%-   if port.dir == 'output' and port.name in ('valid', 'ready', 'psel', 'penable', 'strobe', 'enable') %}{% set has_strobe.found = true %}{% endif %}
{%- endfor %}
{%- if has_strobe.found %}
    // One cycle later: de-assert strobes
    @(vif.cb);
{%-   for port in ports %}
{%-     if port.dir == 'output' and port.name in ('valid', 'ready', 'psel', 'penable', 'strobe', 'enable') %}
    vif.cb.{{ port.name }} <= 1'b0;
{%-     endif %}
{%-   endfor %}
{%- endif %}
  endtask

  virtual function void report_phase(uvm_phase phase);
    `uvm_info("DRV", $sformatf(
      "Driver %s: driven=%0d", get_full_name(), m_driven), UVM_NONE)
  endfunction

endclass : {{ agent.name }}_driver
