// Interface Structure: {{ name }}_struct
// 将 interface 信号封装为 struct，便于采样和传递
typedef struct packed {
{%- for port in ports %}
{%-   set width_str = port.width|string %}
{%-   if width_str == '1' %}
  logic {{ port.name }};                     // {{ port.dir }}
{%-   else %}
  logic [{{ port.width }}-1:0] {{ port.name }};  // {{ port.dir }}
{%-   endif %}
{%- endfor %}
} {{ name }}_struct_t;