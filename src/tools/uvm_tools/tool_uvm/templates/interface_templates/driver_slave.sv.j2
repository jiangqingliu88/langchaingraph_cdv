// ============================================================
// Slave Driver: {{ agent.name }}_slave_driver
// ============================================================

class {{ agent.name }}_slave_driver extends uvm_driver #({{ agent.name }}_slave_seq_item);
  `uvm_component_utils({{ agent.name }}_slave_driver)

  virtual {{ agent.name }}_if vif;
  {{ agent.name }}_slave_config cfg;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db#(virtual {{ agent.name }}_if)::get(this, "", "vif", vif))
      `uvm_fatal("NOVIF", "Virtual interface not set")
    if (!uvm_config_db#({{ agent.name }}_slave_config)::get(this, "", "cfg", cfg))
      `uvm_fatal("CFG", "Config not set")
  endfunction

  task run_phase(uvm_phase phase);
    forever begin
      {{ agent.name }}_slave_seq_item rsp;
      seq_item_port.get_next_item(rsp);
      drive_response(rsp);
      seq_item_port.item_done();
    end
  endtask

  virtual task drive_response({{ agent.name }}_slave_seq_item rsp);
    // 响应延迟（由 slave sequence 决定）
    repeat (rsp.delay_cycles) @(vif.slave_cb);
{%- set has_input_port = namespace(found=false) %}
{%- for port in ports %}
{%-   if port.dir == 'input' %}{% set has_input_port.found = true %}{% endif %}
{%- endfor %}
{%- if has_input_port.found %}
    // 默认：将请求字段回填到 slave 驱动的 input 端口
    @(vif.slave_cb);
{%-   for port in ports %}
{%-     if port.dir == 'input' %}
{%-       set port_in_txn = namespace(found=false) %}
{%-       for var in transaction_vars %}
{%-         if var.name == port.name %}{% set port_in_txn.found = true %}{% endif %}
{%-       endfor %}
{%-       if port_in_txn.found %}
    vif.slave_cb.{{ port.name }} <= rsp.{{ port.name }};
{%-       endif %}
{%-     endif %}
{%-   endfor %}
{%- else %}
    // 无 input 端口：slave 仅产生响应延迟，不做信号驱动
    `uvm_info("SLV_DRV", $sformatf("slave response delay=%0d", rsp.delay_cycles), UVM_HIGH)
{%- endif %}
  endtask
endclass : {{ agent.name }}_slave_driver
