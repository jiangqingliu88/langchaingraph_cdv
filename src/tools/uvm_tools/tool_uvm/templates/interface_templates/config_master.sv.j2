// ============================================================
// Master Config: {{ agent.name }}_master_config
// ============================================================

class {{ agent.name }}_master_config extends uvm_object;
  `uvm_object_utils({{ agent.name }}_master_config)

  // 公共协议参数
  int addr_width = 32;
  int data_width = 32;
  int id_width   = 4;

  // 模式控制
  uvm_active_passive_enum is_active = UVM_ACTIVE;

  // 错误注入公共开关
  int error_injection_rate = 0; // 0~100

  // 虚拟接口句柄（由 TB 传入）
  virtual {{ agent.name }}_if vif;

  // ── Master 专属 ──
  // 驱动延迟（背压控制）
  int drive_delay_min = 0;
  int drive_delay_max = 0;

  // Outstanding 与乱序（预留接口）
  int max_outstanding          = 8;
  bit enable_out_of_order_resp = 1;

  // 超时检测
  int response_timeout   = 100;
  bit timeout_raise_error = 1;

{%- for var in config_vars %}
  rand {{ var.type }} {{ var.name }};
{%- endfor %}

{%- for cons in config_constraints %}
  constraint {{ cons.name }} {{ cons.value | safe }}
{%- endfor %}

  function new(string name = "{{ agent.name }}_master_config");
    super.new(name);
  endfunction

  function string convert2string();
    string s = super.convert2string();
    s = {s, $sformatf("\n  role: MASTER")};
    s = {s, $sformatf("\n  active: %s", is_active.name())};
    s = {s, $sformatf("\n  addr_width: %0d", addr_width)};
    s = {s, $sformatf("\n  data_width: %0d", data_width)};
    s = {s, $sformatf("\n  error_injection_rate: %0d%%", error_injection_rate)};
    return s;
  endfunction
endclass : {{ agent.name }}_master_config
