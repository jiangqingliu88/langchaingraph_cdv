{% include "base_templates/base_template.sv.j2" %}

// ============================================================
// Loopback Testbench: {{ agent.name }}_loopback_tb
// ============================================================
// interface 内部 logic + modport，无需外部端口连接
`include "uvm_macros.svh"
import uvm_pkg::*;
import {{ agent.name }}_pkg::*;

module {{ agent.name }}_loopback_tb;
  logic clk   = 0;
  logic rst_n = 0;

  // 接口实例
  {{ agent.name }}_if #(
{%- for param in parameters %}
    .{{ param.name }}({{ param.value }}){% if not loop.last %},{% endif %}
{%- endfor %}
  ) {{ agent.name }}_if_inst (
    .{{ agent.clock }}(clk),
    .{{ agent.reset }}(rst_n)
  );

  always #5 clk = ~clk;

  initial begin
    uvm_config_db#(virtual {{ agent.name }}_if)::set(null, "*", "vif", {{ agent.name }}_if_inst);
    run_test("{{ agent.name }}_loopback_test");
  end

  initial begin
    #100 rst_n = 1;
    #50000000 $display("LOOPBACK_TIMEOUT");
    $finish;
  end
endmodule : {{ agent.name }}_loopback_tb
