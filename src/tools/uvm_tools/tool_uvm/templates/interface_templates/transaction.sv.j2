// Sequence Item: {{ agent.name }}_seq_item

class {{ agent.name }}_seq_item extends uvm_sequence_item;

{%- for var in transaction_vars %}
  rand {{ var.type }} {{ var.name }}; // is_compare={{ var.iscompare }}, is_rand={{ var.isrand }}
{%- endfor %}

  // ─── 内建字段 ───
  int      req_id;
  int      tag;
  bit      error;
  realtime begin_time;

  // ─── Field Registration ───
  `uvm_object_utils_begin({{ agent.name }}_seq_item)
{%- for var in transaction_vars %}
    `uvm_field_int({{ var.name }}, UVM_ALL_ON)
{%- endfor %}
    `uvm_field_int(req_id, UVM_ALL_ON)
    `uvm_field_int(tag, UVM_ALL_ON)
    `uvm_field_int(error, UVM_ALL_ON)
    `uvm_field_real(begin_time, UVM_ALL_ON)
  `uvm_object_utils_end

{%- for cons in transaction_constraints %}
  constraint {{ cons.name }} {{ cons.value | safe }}
{%- endfor %}

  function new(string name = "{{ agent.name }}_seq_item");
    super.new(name);
  endfunction
endclass : {{ agent.name }}_seq_item