// ============================================================
// Slave Monitor: {{ agent.name }}_slave_monitor
// ============================================================
// ★ 事件驱动：抓到请求后 clone 写入 Slave Sequencer 的 req_fifo

class {{ agent.name }}_slave_monitor extends uvm_monitor;
  `uvm_component_utils({{ agent.name }}_slave_monitor)

  virtual {{ agent.name }}_if vif;
  {{ agent.name }}_slave_config cfg;
  uvm_analysis_port #({{ agent.name }}_slave_seq_item) mon_ap;
  {{ agent.name }}_slave_sequencer sqr;  // ★ 持有 Sequencer 句柄

  function new(string name, uvm_component parent);
    super.new(name, parent);
    mon_ap = new("mon_ap", this);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db#(virtual {{ agent.name }}_if)::get(this, "", "vif", vif))
      `uvm_fatal("NOVIF", "Virtual interface not set")
    if (!uvm_config_db#({{ agent.name }}_slave_config)::get(this, "", "cfg", cfg))
      `uvm_fatal("CFG", "Config not set")
    uvm_config_db#({{ agent.name }}_slave_sequencer)::get(this, "", "sqr", sqr);
  endfunction

  task run_phase(uvm_phase phase);
    forever begin
      {{ agent.name }}_slave_seq_item tx;
      tx = {{ agent.name }}_slave_seq_item::type_id::create("tx");
      collect_transaction(tx);
      mon_ap.write(tx);
      // ★ 核心：塞进 Sequencer FIFO
      if (sqr != null) begin
        {{ agent.name }}_slave_seq_item tx_clone;
        $cast(tx_clone, tx.clone());
        sqr.req_fifo.write(tx_clone);
      end
    end
  endtask

  virtual task collect_transaction({{ agent.name }}_slave_seq_item tx);
{% if agent.custom_collect_logic %}
    // === LLM-generated frame collection (task 级) ===
{{ agent.custom_collect_logic | indent(4, first=true) }}
{% else %}
    @(vif.mon_cb);
{%- for var in transaction_vars %}
{%-   set port_in_ports = namespace(found=false) %}
{%-   for port in ports %}
{%-     if port.name == var.name %}{% set port_in_ports.found = true %}{% endif %}
{%-   endfor %}
{%-   if port_in_ports.found %}
    tx.{{ var.name }} = vif.{{ var.name }};
{%-   endif %}
{%- endfor %}
{% endif %}
  endtask
endclass : {{ agent.name }}_slave_monitor
