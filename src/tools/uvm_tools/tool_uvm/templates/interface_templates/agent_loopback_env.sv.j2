import uvm_pkg::*;
import {{ agent.name }}_pkg::*;
`include "uvm_macros.svh"

// Forward declaration: SCB 在 agent_loopback_scb.sv 中定义，此文件之后编译
typedef class {{ agent.name }}_loopback_scb;

// === Agent Loopback Env: {{ agent.name }} ===
// 单 Agent 自测环境 —— Driver → Monitor 闭环验证

class {{ agent.name }}_loopback_env extends uvm_env;
  `uvm_component_utils({{ agent.name }}_loopback_env)

  {{ agent.name }}_agent        agent_h;
  {{ agent.name }}_loopback_scb scb_h;
  {{ agent.name }}_config       cfg;

  function new(string name = "{{ agent.name }}_loopback_env", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    cfg = {{ agent.name }}_config::type_id::create("cfg", this);
    cfg.is_active = UVM_ACTIVE;
    uvm_config_db #({{ agent.name }}_config)::set(this, "*", "cfg", cfg);
    agent_h = {{ agent.name }}_agent::type_id::create("agent_h", this);
    scb_h   = {{ agent.name }}_loopback_scb::type_id::create("scb_h", this);
  endfunction

  virtual function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    agent_h.drv.expected_port.connect(scb_h.expected_export);
    agent_h.mon.item_collected_port.connect(scb_h.actual_export);
  endfunction

endclass : {{ agent.name }}_loopback_env
