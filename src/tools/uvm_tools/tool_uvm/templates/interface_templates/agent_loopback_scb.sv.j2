{% include "base_templates/base_template.sv.j2" %}

// ============================================================
// Loopback Scoreboard: {{ agent.name }}_loopback_scb
// ============================================================
// expected_export ← master monitor (master 实际驱动的字段)
// actual_export   ← slave monitor  (slave 观察到的字段)
// 比较 master_seq_item 与 slave_seq_item 的 is_compare 公共字段
import uvm_pkg::*;
import {{ agent.name }}_pkg::*;
`include "uvm_macros.svh"

`uvm_analysis_imp_decl(_expected)
`uvm_analysis_imp_decl(_actual)

class {{ agent.name }}_loopback_scb extends uvm_scoreboard;
  `uvm_component_utils({{ agent.name }}_loopback_scb)

  uvm_analysis_imp_expected #({{ agent.name }}_master_seq_item, {{ agent.name }}_loopback_scb) expected_export;
  uvm_analysis_imp_actual   #({{ agent.name }}_slave_seq_item,  {{ agent.name }}_loopback_scb) actual_export;

  protected {{ agent.name }}_master_seq_item expected_q[$];
  protected int m_matched    = 0;
  protected int m_mismatched = 0;
  protected int m_total      = 0;

  function new(string name = "{{ agent.name }}_loopback_scb", uvm_component parent = null);
    super.new(name, parent);
    expected_export = new("expected_export", this);
    actual_export   = new("actual_export",   this);
  endfunction

  virtual function void write_expected({{ agent.name }}_master_seq_item exp);
    expected_q.push_back(exp);
  endfunction

  virtual function void write_actual({{ agent.name }}_slave_seq_item act);
    m_total++;
    if (expected_q.size() > 0) begin
      {{ agent.name }}_master_seq_item exp = expected_q.pop_front();
      if (compare_fields(exp, act)) begin
        m_matched++;
        `uvm_info("SCB_LOOP_PASS", $sformatf("[PASS] #%0d matched", m_total), UVM_MEDIUM)
      end else begin
        m_mismatched++;
        `uvm_error("SCB_LOOP", $sformatf("[FAIL] #%0d mismatched\n  exp=%s\n  act=%s",
          m_total, exp.convert2string(), act.convert2string()))
      end
    end else begin
      m_mismatched++;
      `uvm_warning("SCB_LOOP", "Received actual without expected")
    end
  endfunction

  // 比较 master_seq_item 与 slave_seq_item 的 is_compare 公共字段
  virtual function bit compare_fields({{ agent.name }}_master_seq_item exp,
                                      {{ agent.name }}_slave_seq_item act);
    bit ok = 1;
{%- for var in transaction_vars %}
{%-   if var.iscompare == 'True' and var.is_master != 'False' %}
    ok &= (exp.{{ var.name }} == act.{{ var.name }});
{%-   endif %}
{%- endfor %}
    return ok;
  endfunction

  virtual function void report_phase(uvm_phase phase);
    super.report_phase(phase);
    `uvm_info("SCB_LOOP", $sformatf(
      "Scoreboard: total=%0d matched=%0d mismatched=%0d pending=%0d",
      m_total, m_matched, m_mismatched, expected_q.size()), UVM_NONE)
  endfunction

endclass : {{ agent.name }}_loopback_scb
