{% include "base_templates/base_template.sv.j2" %}

// Test Package: {{ environment.env_name }}_test_pkg
package {{ environment.env_name }}_test_pkg;
  import uvm_pkg::*;
  `include "uvm_macros.svh"
    // 直接导入 Agent 包（SV import 不可传递）
    //
    // 用 `agent.interface`（协议名，如 apb）而**不是** `agent.name`
    //（实例名，如 apb_master）—— 真实的包叫 `apb_pkg`。这里原来写的是 agent.name，
    // 生成 `import apb_master_pkg::*`：一个不存在的包。
{%- for agent in agents %}
  import {{ agent.interface }}_pkg::*;
  import {{ agent.interface }}_typedefs_pkg::*;
  import {{ agent.interface }}_parameters_pkg::*;
{%- endfor %}
  // 导入 env 包（apb_env / apb_env_config 这些类住在里面）
  import {{ environment.env_name }}_pkg::*;
  // 环境序列在 seq 包里，测试要用（apb_master_sequence 这些）——
  // **只能 import seq_pkg**，因为 seq 类都定义在那个 package 内。
  import {{ environment.env_name }}_seq_pkg::*;



  // 包含环境组件文件
  `include "{{ environment.env_name }}_base_test.sv"
  `include "{{ environment.env_name }}_direct_test.sv"
  `include "{{ environment.env_name }}_gen_test.sv"
{%- if tests %}

  // 属性测试（一条 environment.tests = 一个 UVM_TEST = 一个属性取值）
  `include "{{ environment.env_name }}_attr_test.sv"
{%- endif %}
{%- if environment.batches %}

  // 批次测试（一条 environment.batches = 一个 UVM_TEST = 一个批次/专题）。
  //
  // ⚠️ **必须 include 进来**：`_batch_test.sv` 不产在这个包里，包外也没人单独编它
  //（filelist 只收 `env/tests/` 下的 **package**，不是每个 .sv）——漏掉这一句，
  // 那些类就**根本没被编译过**，而回归里 `+UVM_TESTNAME=npu_basic_test` 撞
  // `UVM_FATAL (INVTST) not found`（实测：p0 里 1 条批次测试挂在这）。
  // 类体 extends 的是 `_gen_test`（上面已 include），所以这句要排在它之后。
  `include "{{ environment.env_name }}_batch_test.sv"
{%- endif %}
{%- if register_model and register_model.reg_block %}

  // 寄存器（CSR）自带序列测试：hw_reset（复位值）/ bit_bash（逐位翻）/ access（前后门一致）。
  // 三个都只是 UVM 官方寄存器序列的一层薄壳，仅在配了 register_model 时生成
  //（见 gen_uvm.py 的 ENVIRONMENT_REG_TEST_TEMPLATES）。
  `include "{{ environment.env_name }}_reg_hw_reset_test.sv"
  `include "{{ environment.env_name }}_reg_bit_bash_test.sv"
  `include "{{ environment.env_name }}_reg_access_test.sv"
{%- endif %}


endpackage : {{ environment.env_name }}_test_pkg