{% include "base_templates/base_template.sv.j2" %}

// Directed Test: {{ environment.env_name }}_directed_test
// 执行特定场景测试

class {{ environment.env_name }}_directed_test extends {{ environment.env_name }}_base_test;
  `uvm_component_utils({{ environment.env_name }}_directed_test)

  function new(string name = "{{ environment.env_name }}_directed_test", uvm_component parent);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    // 定向测试配置
{%- for agent in agents %}
    cfg.{{ agent.name }}_cfg.is_active = {{ 'UVM_ACTIVE' if agent.active is not false else 'UVM_PASSIVE' }};
    cfg.{{ agent.name }}_cfg.has_coverage = 1'b0;
{%- endfor %}
    // pragma custom build_logic begin
    // pragma custom build_logic end
  endfunction

  virtual task configure_phase(uvm_phase phase);
    super.configure_phase(phase);
    `uvm_info(get_type_name(), "configure_phase: start", UVM_MEDIUM)
    phase.raise_objection(this);
    phase.drop_objection(this);
  endtask

  virtual task main_phase(uvm_phase phase);
    super.main_phase(phase);
    `uvm_info(get_type_name(), "main_phase: start", UVM_MEDIUM)
    phase.raise_objection(this);

    // 在**有 sequencer 的** Agent 上启动定向序列。
    //
    // 两个条件都要：
    //   · `is_master` —— slave 实例是响应侧，没有自己的激励序列
    //   · `is_active` —— **passive 实例根本不创建 sequencer**
    //     （agent 模板里 `sequencer` 只在 `cfg.is_active == UVM_ACTIVE` 时 create）。
    // 光看 is_master 会在 passive agent 上 `_seq.start(null)` —— sequencer 是 null，
    // 序列永远等不到 `start_item` 的授权，main_phase 的 objection 永不释放，
    // 一路挂到 UVM 的 PH_TIMEOUT（9200 秒仿真时间）。
    // 实测：intr 是 passive，整条定向测试就此超时，回归 23 条全红。
{%- for agent in agents %}
{%- if agent.is_master is not false and agent.active is not false %}
    begin
      {{ agent.sequence_type }} _seq;
      _seq = {{ agent.sequence_type }}::type_id::create("_seq");
      _seq.start(env.{{ agent.name }}_agent_h.sequencer);
    end
{%- endif %}
{%- endfor %}

    // pragma custom run_logic begin
    // pragma custom run_logic end

    phase.drop_objection(this);
  endtask

endclass : {{ environment.env_name }}_directed_test
