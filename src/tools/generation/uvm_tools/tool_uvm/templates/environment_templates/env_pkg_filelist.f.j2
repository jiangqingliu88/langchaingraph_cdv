{% include "base_templates/base_template.sv.j2" %}

// ============================================================
// UVM 编译 filelist —— 整环境 + bench + testpoint TC 一键编译
// 用法: source Sourceme          # 定义 $WORK_PATH = 当前目录
//       vlog -sv -f {{ environment.env_name }}_pkg_filelist.f
// 路径一律以 $WORK_PATH 为根（而非生成时刻的绝对路径），故整目录可整体搬迁、
// 换机器不必重新生成。
// ============================================================
// DUT (项目源码)
{{ dut_path }}

// ─── Base PKG: Clock & Reset VIP + Scoreboard 组件族 + 公共类型 ───
+incdir+{{ base_pkg_dir }}/clk_and_rst
{{ base_pkg_dir }}/clk_and_rst/clk_and_rst_pkg.sv
+incdir+{{ base_pkg_dir }}/scb
{{ base_pkg_dir }}/scb/scb_pkg.sv
+incdir+{{ base_pkg_dir }}/common_typedefs
{{ base_pkg_dir }}/common_typedefs/common_typedefs_pkg.sv

// ─── Interface & Agent Package（interface 级 agent 目录）───
{%- for ia in interface_agents %}
+incdir+{{ agent_dir }}/{{ ia.name }}_agent
{{ agent_dir }}/{{ ia.name }}_agent/1_interface/{{ ia.name }}_if.sv
{{ agent_dir }}/{{ ia.name }}_agent/1_interface/{{ ia.name }}_system_if.sv
{{ agent_dir }}/{{ ia.name }}_agent/{{ ia.name }}_parameters_pkg.sv
{{ agent_dir }}/{{ ia.name }}_agent/{{ ia.name }}_typedefs_pkg.sv
{{ agent_dir }}/{{ ia.name }}_agent/{{ ia.name }}_pkg.sv
{%- endfor %}

// ─── Harness（bind 式，须在 tb_top 前编译）──
{%- for h in harnesses %}
{{ bench_dir }}/{{ h.name }}.sv
{%- endfor %}

// ─── VIP env（外部 VIP 集成，vip_path 指向 VIP 源码/incdir）──
{%- for ve in vipenvs %}
{%- if ve.vip_path %}
+incdir+{{ ve.vip_path }}
{%- endif %}
{%- endfor %}

// ─── Environment ───
+incdir+{{ env_dir }}
{{ env_dir }}/{{ environment.env_name }}_parameters_pkg.sv
// env_pkg 里 `include "utils/<name>_util.sv"`（工具组件/参考模型）**不需要**
// `+incdir+{{ env_dir }}/utils` —— `include` 是**相对 include**：先按"包含这条
// 指令的文件所在目录"解析，而 env_pkg.sv 就在 `{{ env_dir }}/` 下，于是
// `utils/x_util.sv` 直接落到 `{{ env_dir }}/utils/x_util.sv`。实测 vlog 通过
// （真不存在的路径会响亮报 "Cannot open include file"）。**别好心加一句
// `+incdir+env/utils`** —— 它不解决问题，只会让"哪条路径才是权威"多一个来源。
{{ env_dir }}/{{ environment.env_name }}_pkg.sv
+incdir+{{ env_dir }}/tests
{{ env_dir }}/tests/{{ environment.env_name }}_test_pkg.sv
+incdir+{{ env_dir }}/seqs
{{ env_dir }}/seqs/{{ environment.env_name }}_seq_pkg.sv

// ─── Testpoint TC（tool_testgen 产物，可选；tc_constraints 随 tc_pkg include）──
+incdir+{{ env_dir }}/..
{{ env_dir }}/../{{ environment.env_name }}_tc_pkg.sv

// ─── Testbench Top ───
{{ bench_dir }}/{{ bench_name }}_tb_top.sv
