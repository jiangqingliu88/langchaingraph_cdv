        {
          "kind": "src_core_hit",
          "target": "4b_src_core_id"
        }
      ],
      "effects": [
        {
          "kind": "move",
          "target": "lmem"
        }
      ],
      "roles": {
        "binds": [
          "src"
        ],
        "writes": [
          "dst"
        ]
      }
    },
    {
