// Sequence Item: {{ agent.name }}_seq_item
// 通过 `include 引入，不包含独立 package

{%- if hvl_typedefs %}
// HVL 类型定义
{%-   for td in hvl_typedefs %}
typedef {{ td.type }} {{ td.name }};
{%-   endfor %}
{%- endif %}

class {{ agent.name }}_seq_item extends uvm_sequence_item;
  `uvm_object_utils({{ agent.name }}_seq_item)

{%- for var in transaction_vars %}
  rand {{ var.type }} {{ var.name }}; // is_compare={{ var.iscompare }}, is_rand={{ var.isrand }}
{%- endfor %}

  // ── 物理端口字段（Driver 驱动 / Monitor 采样）──
{%- for port in ports %}
{%-   if port.name != clock and port.name != reset %}
{%-     set width_str = port.width|string %}
{%-     if width_str == '1' %}
  rand logic {{ port.name }};  // {{ port.dir }}
{%-     else %}
  rand logic [{{ port.width }}-1:0] {{ port.name }};  // {{ port.dir }}
{%-     endif %}
{%-   endif %}
{%- endfor %}

  // ─── 内建字段 ───
  int      req_id;
  int      tag;
  bit      error;
  realtime begin_time;

{%- for cons in transaction_constraints %}
  constraint {{ cons.name }} {{ cons.value | safe }}
{%- endfor %}

  function new(string name = "{{ agent.name }}_seq_item");
    super.new(name);
  endfunction
endclass : {{ agent.name }}_seq_item