// Agent Package: {{ agent.name }}_pkg
package {{ agent.name }}_pkg;
  import uvm_pkg::*;
  `include "uvm_macros.svh"

  // UVM-1.2 callback macros (use built-in if available, otherwise stub)
  `ifndef uvm_register_cb
  `define uvm_register_cb(T, CB) \
     static local bit m_register_cb_``CB = uvm_callbacks #(T,CB)::m_register_pair(`"T`",`"CB`");
  `endif
  `ifndef uvm_do_callbacks
  `define uvm_do_callbacks(T, CB, METHOD) \
     uvm_callbacks #(T,CB)::m_do_callbacks(this, METHOD)
  `endif

{%- for param in agent.parameters %}
  localparam {{ param.type }} {{ param.name }} = {{ param.value }};
{%- endfor %}
{%- if agent.hdl_typedefs %}
  // HDL type definitions (mirror interface typedefs)
{%-   for td in agent.hdl_typedefs %}
  typedef {{ td.type }} {{ td.name }};
{%-   endfor %}
{%- endif %}
{%- if agent.hvl_typedefs %}
  // HVL type definitions
{%-   for td in agent.hvl_typedefs %}
  typedef {{ td.type }} {{ td.name }};
{%-   endfor %}
{%- endif %}

  `include "{{ agent.name }}_interface_structure.sv"
  `include "{{ agent.name }}_transaction.sv"
  `include "{{ agent.name }}_config.sv"
  `include "{{ agent.name }}_driver.sv"
  `include "{{ agent.name }}_monitor.sv"
  `include "{{ agent.name }}_sequencer.sv"
  `include "{{ agent.name }}_base_seq.sv"
  `include "{{ agent.name }}_coverage_collector.sv"
  `include "{{ agent.name }}_agent.sv"
`ifdef {{ agent.name }}_loop_back_test
  `include "loopback/{{ agent.name }}_loopback_env.sv"
  `include "loopback/{{ agent.name }}_loopback_scb.sv"
  `include "loopback/{{ agent.name }}_loopback_test.sv"
`endif
endpackage : {{ agent.name }}_pkg