// {{ project.name }}_coordinated_sequence.sv
// 自动生成的协调序列

`include "{{ project.env_name }}_policy_factory.sv"

class {{ project.env_name }}_coordinated_sequence extends uvm_virtual_sequence;
  `uvm_object_utils({{ project.env_name }}_coordinated_sequence)
  `uvm_declare_p_sequencer({{ project.env_name }}_virtual_sequencer)
  
  // 策略组合器
  {{ project.env_name }}_policy_combinator policy_combo;
  
  // 事务队列
  {{ project.env_name }}_policy_context queue[$];
  
  // 配置
  int num_transactions = 100;
  int queue_size = 10;
  int transaction_timeout_ms = 1000;
  
  // 统计
  int generated_count = 0;
  int processed_count = 0;
  
  function new(string name = "{{ project.name }}_coordinated_sequence");
    super.new(name);
    policy_combo = {{ project.env_name }}_policy_factory::create_from_plusargs();
  endfunction
  
  virtual task body();
    `uvm_info(get_name(), $sformatf("Starting coordinated sequence with %0d policies",
               policy_combo.policies.size()), UVM_MEDIUM)
    
    configure_from_plusargs();
    
    fork
      generate_transactions();
      process_transactions();
    join
    
    report_summary();
  endtask
  
  virtual task generate_transactions();
    for (int i = 0; i < num_transactions; i++) begin
      {{ project.env_name }}_policy_context ctx = new();
      
      // 设置元数据
      ctx.scenario_name = get_name();
      ctx.iteration = i;
      ctx.total_iterations = num_transactions;
      ctx.timestamp = $time;
      
      // 创建基础事务
      create_base_transactions(ctx);
      
      // 应用策略约束
      policy_combo.apply(ctx);
      
      // 验证一致性
      if (!policy_combo.verify(ctx)) begin
        `uvm_error(get_name(), $sformatf("Policy verification failed at iteration %0d", i))
      end
      
      // 入队
      queue.push_back(ctx);
      generated_count++;
      
      // 队列流控
      while (queue.size() > queue_size) #1;
    end
    
    // 等待处理完成
    while (processed_count < generated_count) #1;
  endtask
  
  virtual task process_transactions();
    while (1) begin
      if (queue.size() > 0) begin
        {{ project.env_name }}_policy_context ctx = queue.pop_front();
        
        fork
          begin
            fork
              send_transactions(ctx);
              begin
                #(transaction_timeout_ms * 1ms);
                `uvm_error(get_name(), $sformatf("Transaction timeout at iteration %0d",
                           ctx.iteration))
              end
            join_any
            disable fork;
          end
        join_none
        
        processed_count++;
      end
      #1;
    end
  endtask
  
  // 创建基础事务（可被继承重写）
  virtual function void create_base_transactions(ref {{ project.env_name }}_policy_context ctx);
    // 创建并随机化各个事务
{% for trans in transactions %}
    {{ trans.type }} {{ trans.name }}_trans = {{ trans.type }}::type_id::create("{{ trans.name }}_trans");
    assert({{ trans.name }}_trans.randomize());
    ctx.set_transaction("{{ trans.name }}", {{ trans.name }}_trans);
{% endfor %}
  endfunction
  
  // 发送事务（可被继承重写）
  virtual task send_transactions(ref {{ project.env_name }}_policy_context ctx);
    // 发送到对应的 sequencer
{% for trans in transactions %}
    begin
      {{ trans.type }} {{ trans.name }}_trans;
      $cast({{ trans.name }}_trans, ctx.get_transaction("{{ trans.name }}"));
      if ({{ trans.name }}_trans != null && p_sequencer.{{ trans.name }}_sqr != null) begin
        start_item({{ trans.name }}_trans, p_sequencer.{{ trans.name }}_sqr);
        finish_item({{ trans.name }}_trans, p_sequencer.{{ trans.name }}_sqr);
      end
    end
{% endfor %}
  endtask
  
  // 配置
  function void configure_from_plusargs();
    int num;
    if ($value$plusargs("{{ project.env_name | upper }}_NUM_TRANS=%0d", num))
      num_transactions = num;
    if ($value$plusargs("{{ project.env_name | upper }}_QUEUE_SIZE=%0d", num))
      queue_size = num;
    if ($value$plusargs("{{ project.env_name | upper }}_TIMEOUT_MS=%0d", num))
      transaction_timeout_ms = num;
  endfunction
  
  // 报告
  function void report_summary();
    `uvm_info(get_name(), "========================================", UVM_NONE)
    `uvm_info(get_name(), $sformatf("Generated: %0d, Processed: %0d", 
               generated_count, processed_count), UVM_NONE)
    policy_combo.report_stats();
    `uvm_info(get_name(), "========================================", UVM_NONE)
  endfunction
endclass