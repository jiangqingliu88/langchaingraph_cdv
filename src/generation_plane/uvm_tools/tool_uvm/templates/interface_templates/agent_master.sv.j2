{% include "base_templates/base_template.sv.j2" %}

// ============================================================
// Master Agent: {{ agent.name }}_master_agent
// ============================================================

class {{ agent.name }}_master_agent extends uvm_agent;
  `uvm_component_utils({{ agent.name }}_master_agent)

  {{ agent.name }}_master_sequencer sequencer;
  {{ agent.name }}_master_driver    driver;
  {{ agent.name }}_port_monitor   monitor;
  {{ agent.name }}_port_config    cfg;
  uvm_analysis_port #({{ agent.name }}_master_seq_item) {{ agent.name }}_master_agent_ap;         // master 侧抓包
  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    void'(uvm_config_db#({{ agent.name }}_port_config)::get(this, "", "cfg", cfg));
    if (cfg == null)
      cfg = {{ agent.name }}_port_config::type_id::create("cfg", this);

    // 虚拟接口：tb_top 用 `*.<agent 实例路径>*` 把接口实例 set 进 config_db
    //（`uvm_config_db#(virtual {{ agent.name }}_if)::set(null, "*.{{ agent.name }}_master_agent_h*", "vif", ...)`）。
    // 这里取出来存进 cfg.vif，再往下发给 monitor / driver。
    if (cfg.vif == null)
      void'(uvm_config_db#(virtual {{ agent.name }}_if)::get(this, "", "vif", cfg.vif));

    // ⚠️ 子组件的 cfg / vif 必须在 **create 之前** set：UVM 的 build 是自上而下，
    // 父组件 build_phase 里 create 出来的子组件，其 build_phase **紧接着**就执行
    // —— 放到 connect_phase 才 set 就太晚了：driver 的 build_phase 里
    // `uvm_config_db#(...)::get(this, "", "cfg", cfg)` 取不到，直接
    // `uvm_fatal("[CFG] Config not set")`，仿真在 0 时刻就挂。
    uvm_config_db#({{ agent.name }}_port_config)::set(this, "monitor", "cfg", cfg);
    uvm_config_db#(virtual {{ agent.name }}_if)::set(this, "monitor", "vif", cfg.vif);

    monitor = {{ agent.name }}_port_monitor::type_id::create("monitor", this);
    if (cfg.is_active == UVM_ACTIVE) begin
      uvm_config_db#({{ agent.name }}_port_config)::set(this, "sequencer", "cfg", cfg);
      sequencer = {{ agent.name }}_master_sequencer::type_id::create("sequencer", this);
      uvm_config_db#({{ agent.name }}_port_config)::set(this, "driver", "cfg", cfg);
      uvm_config_db#(virtual {{ agent.name }}_if)::set(this, "driver", "vif", cfg.vif);
      driver    = {{ agent.name }}_master_driver::type_id::create("driver", this);
    end
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
     {{ agent.name }}_master_agent_ap= monitor.master_mon_ap;   // 注：原为 _maser_（少个 t），与第 14 行的声明对不上 → vlog 报未定义变量
    if (cfg.is_active == UVM_ACTIVE)
      driver.seq_item_port.connect(sequencer.seq_item_export);
  endfunction
endclass : {{ agent.name }}_master_agent
