`ifndef {{ project.env_name | upper }}_CONSTRAINT_POLICY_SV
`define {{ project.env_name | upper }}_CONSTRAINT_POLICY_SV

// 策略上下文
class {{ project.env_name }}_policy_context extends uvm_object;
  `uvm_object_utils({{ project.env_name }}_policy_context)
  
  // 事务存储
{% for trans in transactions %}
  {{ trans.type }} {{ trans.name }}_trans;
{% endfor %}
  
  // 元数据
  string scenario_name;
  int iteration;
  int total_iterations;
  int timestamp;
  
  function new(string name = "{{ project.env_name }}_policy_context");
    super.new(name);
  endfunction
  
  // 获取事务
  function uvm_object get_transaction(string name);
    case (name)
{% for trans in transactions %}
      "{{ trans.name }}": return {{ trans.name }}_trans;
{% endfor %}
      default: return null;
    endcase
  endfunction
  
  // 设置事务
  function void set_transaction(string name, uvm_object trans);
    case (name)
{% for trans in transactions %}
      "{{ trans.name }}": begin
        if (!$cast({{ trans.name }}_trans, trans))
          `uvm_error("CONTEXT", $sformatf("Cannot cast to {{ trans.type }}"))
      end
{% endfor %}
      default: `uvm_warning("CONTEXT", $sformatf("Unknown transaction: %s", name))
    endcase
  endfunction
  
  // 复制上下文
  function void copy({{ project.env_name }}_policy_context other);
    this.scenario_name = other.scenario_name;
    this.iteration = other.iteration;
    this.total_iterations = other.total_iterations;
    this.timestamp = other.timestamp;
{% for trans in transactions %}
    this.{{ trans.name }}_trans = other.{{ trans.name }}_trans;
{% endfor %}
  endfunction
endclass

// 策略基类
class {{ project.env_name }}_constraint_policy extends uvm_object;
  `uvm_object_utils({{ project.env_name }}_constraint_policy)
  
  string policy_name;
  bit enabled = 1;
  int priority = 100;
  string params[string];
  
  function new(string name = "{{ project.env_name }}_constraint_policy");
    super.new(name);
  endfunction
  
  // 应用约束
  virtual function void apply(ref {{ project.env_name }}_policy_context ctx);
    // 子类实现
  endfunction
  
  // 验证一致性
  virtual function bit verify(ref {{ project.env_name }}_policy_context ctx);
    return 1;
  endfunction
  
  // 获取统计
  virtual function string get_stats();
    return "";
  endfunction
  
  // 解析参数
  virtual function void parse_params(string param_str);
    int start = 0, end;
    do begin
      end = param_str.index(",", start);
      string kv;
      if (end == -1)
        kv = param_str.substr(start, param_str.len()-1);
      else
        kv = param_str.substr(start, end-1);
      
      int eq_pos = kv.index("=");
      if (eq_pos != -1) begin
        string key = kv.substr(0, eq_pos-1);
        string value = kv.substr(eq_pos+1, kv.len()-1);
        params[key] = value;
      end
      start = end + 1;
    end while (end != -1);
  endfunction
  
  function void disable();
    enabled = 0;
  endfunction
  
  function void enable();
    enabled = 1;
  endfunction
endclass

`endif // {{ project.env_name | upper }}_CONSTRAINT_POLICY_SV