# src/tools/testcase_gen/templates/test.sv.j2
// ============================================
// Test: {{ test_name }}
// Scenario: {{ scenario }}
// Policy Mode: {{ policy_mode }}
// Active Policies: {{ active_policies|join(', ') }}
// ============================================

class {{ test_name }} extends base_test;
    `uvm_component_utils({{ test_name }})
    
    {{ env_name }}_policy_combinator policy_combo;
    
    function new(string name = "{{ test_name }}", uvm_component parent = null);
        super.new(name, parent);
    endfunction
    
    virtual function void build_phase(uvm_phase phase);
        super.build_phase(phase);
        policy_combo = {{ env_name }}_policy_factory::create_from_plusargs();
        policy_combo.apply_mode = {{ policy_mode }};
    endfunction
    
    virtual task run_phase(uvm_phase phase);
        {{ sequence_name }} seq;
        phase.raise_objection(this);
        seq = {{ sequence_name }}::type_id::create("seq");
        seq.policy_combo = policy_combo;
        seq.start(p_sequencer);
        phase.drop_objection(this);
    endtask
    
    virtual function void report_phase(uvm_phase phase);
        super.report_phase(phase);
        policy_combo.report_stats();
{% for check in checks %}
        `uvm_info("{{ test_name }}", "Check {{ check.name }}: {{ check.message }}", UVM_MEDIUM)
{% endfor %}
    endfunction
    
endclass : {{ test_name }}