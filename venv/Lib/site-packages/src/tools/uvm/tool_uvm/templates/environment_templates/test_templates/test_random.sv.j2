// Random Test: {{ environment.env_name }}_random_test
// 执行随机测试

class {{ environment.env_name }}_random_test extends {{ environment.env_name }}_base_test;
  `uvm_component_utils({{ environment.env_name }}_random_test)

  function new(string name = "{{ environment.env_name }}_random_test", uvm_component parent);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    // 随机测试特有配置
    cfg.randomize() with {
{%- for agent in agents %}
      {{ agent.name }}_cfg.is_active == UVM_ACTIVE;
{%- endfor %}
    };
  endfunction

  virtual task run_phase(uvm_phase phase);
    phase.raise_objection(this);

    // 在所有 Agent Sequencer 上启动随机序列
{%- for agent in agents %}
    begin
      {{ agent.name }}_random_seq _seq;
      _seq = {{ agent.name }}_random_seq::type_id::create("_seq");
      _seq.start(env.{{ agent.name }}_agent_h.sqr);
    end
{%- endfor %}

    phase.drop_objection(this);
  endtask

endclass : {{ environment.env_name }}_random_test