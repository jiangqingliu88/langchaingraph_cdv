// === Agent Loopback Testbench: {{ agent.name }} ===
// 单 Agent 自测顶层 —— 独立编译运行，无需完整 env

`include "uvm_macros.svh"
import uvm_pkg::*;
import {{ agent.name }}_pkg::*;

module {{ agent.name }}_loopback_tb;
  reg clk   = 0;
  reg rst_n = 0;

  // 接口实例
  {{ agent.name }}_interface #(
{%- for param in parameters %}
    .{{ param.name }}({{ param.value }}){% if not loop.last %},{% endif %}
{%- endfor %}
  ) {{ agent.name }}_if (.clk(clk), .rst_n(rst_n));

  always #5 clk = ~clk;

  initial begin
    // 设置 virtual interface
    uvm_config_db #(virtual {{ agent.name }}_interface)::set(null, "*", "vif", {{ agent.name }}_if);
    // 启动测试
    run_test("{{ agent.name }}_loopback_test");
  end

  initial begin
    #100 rst_n = 1;
    #500000 $display("LOOPBACK_TIMEOUT");
    $finish;
  end
endmodule : {{ agent.name }}_loopback_tb
