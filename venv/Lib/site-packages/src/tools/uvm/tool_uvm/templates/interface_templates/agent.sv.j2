// Agent: {{ agent.name }}_agent

typedef class {{ agent.name }}_agent;
typedef class {{ agent.name }}_config;

class {{ agent.name }}_agent extends uvm_agent;
  `uvm_component_utils({{ agent.name }}_agent)

  {{ agent.name }}_sequencer  sqr;
  {{ agent.name }}_driver      drv;
  {{ agent.name }}_monitor     mon;
  {{ agent.name }}_config      cfg;

  uvm_analysis_port #({{ agent.name }}_seq_item) agent_ap;

  function new(string name, uvm_component parent);
    super.new(name, parent);
  endfunction

  virtual function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db #({{ agent.name }}_config)::get(this, "", "cfg", cfg))
      `uvm_fatal("CFG", "Config not set")

    uvm_config_db #({{ agent.name }}_config)::set(this, "*", "cfg", cfg);

    mon = {{ agent.name }}_monitor::type_id::create("mon", this);

    if (cfg.is_active == UVM_ACTIVE) begin
      sqr = {{ agent.name }}_sequencer::type_id::create("sqr", this);
      drv = {{ agent.name }}_driver::type_id::create("drv", this);
    end

    agent_ap = new("agent_ap", this);
  endfunction

  virtual function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    if (cfg.is_active == UVM_ACTIVE)
      drv.seq_item_port.connect(sqr.seq_item_export);
    mon.item_collected_port.connect(agent_ap);
  endfunction

endclass : {{ agent.name }}_agent
