"""
配置管理 - 使用Singleton模式 + Pydantic Settings
"""
"""
配置管理 - 支持多种LLM提供商
"""
from typing import Optional, Dict, Any, Literal
from pathlib import Path
import yaml
from pydantic_settings import BaseSettings, SettingsConfigDict
from pydantic import Field, validator

class LLMSettings(BaseSettings):
    """LLM配置 - 支持DeepSeek、OpenAI等"""
    
    # 提供商选择
    provider: Literal["deepseek", "openai", "custom"] = Field(
        default="deepseek",
        description="LLM提供商: deepseek, openai, custom"
    )
    
    # 模型配置
    model: str = Field(
        default="deepseek-chat",
        description="模型名称"
    )
    
    # API配置
    api_key: str = Field(
        default="",
        description="API密钥"
    )
    base_url: Optional[str] = Field(
        default="https://api.deepseek.com/v1",
        description="API基础URL"
    )
    
    # 参数配置
    temperature: float = Field(default=0.0, ge=0.0, le=2.0)
    max_tokens: int = Field(default=4096, ge=1, le=8192)
    top_p: float = Field(default=1.0, ge=0.0, le=1.0)
    frequency_penalty: float = Field(default=0.0)
    presence_penalty: float = Field(default=0.0)
    
    model_config = SettingsConfigDict(env_prefix="LLM_")
    
    @validator("model")
    def validate_deepseek_model(cls, v, values):
        """验证DeepSeek模型名称"""
        provider = values.get("provider", "deepseek")
        if provider == "deepseek":
            valid_models = ["deepseek-chat", "deepseek-coder"]
            if v not in valid_models:
                raise ValueError(f"DeepSeek模型必须是: {valid_models}")
        return v
    
    @property
    def chat_model_kwargs(self) -> Dict[str, Any]:
        """获取聊天模型参数"""
        kwargs = {
            "model": self.model,
            "api_key": self.api_key,
            "temperature": self.temperature,
            "max_tokens": self.max_tokens,
        }
        
        if self.base_url:
            kwargs["base_url"] = self.base_url
        
        if self.top_p < 1.0:
            kwargs["model_kwargs"] = {
                "top_p": self.top_p,
                "frequency_penalty": self.frequency_penalty,
                "presence_penalty": self.presence_penalty,
            }
        
        return kwargs

class Settings(BaseSettings):
    """全局配置"""
    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=False
    )
    
    llm: LLMSettings = Field(default_factory=LLMSettings)
    database: DatabaseSettings = Field(default_factory=DatabaseSettings)
    agent: AgentSettings = Field(default_factory=AgentSettings)
    verification: VerificationSettings = Field(default_factory=VerificationSettings)
    
    # 项目路径
    project_root: Path = Field(default_factory=lambda: Path(__file__).parent.parent)
    config_dir: Path = Field(default_factory=lambda: Path(__file__).parent)
    prompts_dir: Path = Field(default_factory=lambda: Path(__file__).parent.parent / "src" / "prompts")
    
    # Agent配置(从YAML加载)
    agent_config: Dict[str, Any] = Field(default_factory=dict)
    
    @validator("agent_config", pre=True)
    def load_agent_config(cls, v):
        """从YAML加载Agent配置"""
        config_path = Path(__file__).parent / "agent_config.yaml"
        if config_path.exists():
            with open(config_path, "r", encoding="utf-8") as f:
                return yaml.safe_load(f)
        return {}
    
    # Singleton实例
    _instance: Optional["Settings"] = None
    
    @classmethod
    def get_instance(cls) -> "Settings":
        """获取单例实例"""
        if cls._instance is None:
            cls._instance = cls()
        return cls._instance