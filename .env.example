# ══════════════════════════════════════════════════════════
# SignOffAI 环境配置示例
# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密钥。
# ══════════════════════════════════════════════════════════

# ── LLM 提供商（OpenAI 兼容接口）──────────────────────────
# deepseek / openai / custom（自定义 base_url）/ anthropic
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=<your-api-key>
LLM_BASE_URL=https://api.deepseek.com/v1

# 单次输出 token 上限。太小时长输出（多端口 RTL）会被截断。
LLM_MAX_TOKENS=16384

# 主提供商不可用时自动切换（可选）
# LLM_FALLBACK_PROVIDER=openai

# ── 其他 OpenAI 兼容提供商（按需取消注释）────────────────
# 通义千问
# LLM_PROVIDER=custom
# LLM_MODEL=qwen-plus
# LLM_API_KEY=<your-dashscope-key>
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 智谱 GLM-4
# LLM_PROVIDER=custom
# LLM_MODEL=glm-4-plus
# LLM_API_KEY=<your-zhipu-api-key>
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Anthropic Claude（走专用 adapter）
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=<your-anthropic-key>
# LLM_BASE_URL=

# 本地模型（Ollama / vLLM）
# LLM_PROVIDER=custom
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=not-needed
# LLM_BASE_URL=http://localhost:11434/v1

# ── 编排架构（默认 Supervisor 主图 + 专家子图）────────────
# off = 回滚到旧的 24 节点单图（仅用于对照/回滚）
SIGNOFFAI_SUPERVISOR=on
# Debug 专家的 LLM 工具循环（默认 off；on 时先用工具查日志/定位，再回退确定性管线）
SIGNOFFAI_AGENT_LOOP=off

# ── 可选：本地演示 ────────────────────────────────────────
DEMO_ENABLED=0

# ── 可选：本地管理口令（仅在启用 API 服务时需要）─────────
# BOOTSTRAP_ADMIN_PASSWORD=<set-a-strong-password>
