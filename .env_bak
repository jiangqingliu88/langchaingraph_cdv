# .env 文件 - DeepSeek 配置
# DeepSeek API配置
LLM_PROVIDER=deepseek
LLM_API_KEY="sk-507794d503fb4195b85dfe23fba481fa"
#sk-6039322a0eec4cc68f5d546bf9ee7c56
LLM_MODEL=deepseek-chat
